// Now playing: the `Playback` state global (Rust writes it, the UI reads it), the bottom bar and
// the expanded view. Rust sets `position-ms` on player events; the bar's Timer only interpolates
// between events. Nothing here takes keyboard focus.
import { Theme } from "theme.slint";
import { Cover } from "cover.slint";
import { ListView } from "std-widgets.slint";

export struct LyricLetter {
    // One letter of a word, with the position (ms) at which it lights.
    // Thresholds are precomputed in Rust: letters light progressively through the word window.
    ch: string,
    start-ms: int,
}

export struct LyricWord {
    letters: [LyricLetter],
    // Visual row (0 or 1) the word sits on; assigned in Rust from the real window width
    // so the karaoke line wraps instead of truncating or clipping.
    row: int,
}

export struct LyricLine {
    text: string,
    start-ms: int,
    end-ms: int,
    // Per-word letter timings (yoshik.xyz word mode); empty for line-synced or plain lines.
    words: [LyricWord],
    // How many visual rows the word-mode rendering uses (1 or 2).
    word-rows: int,
}

export global Playback {
    in-out property <string> title;
    in-out property <string> artist;
    in-out property <string> album;
    in-out property <image> art;
    // Optional extra: a 56px-sized copy for the bar (crisper than scaling `art` down). Unset, the bar uses `art`.
    in-out property <image> bar-art;
    in-out property <color> accent: Theme.accent;
    in-out property <int> position-ms;
    in-out property <int> duration-ms;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <bool> repeat;
    in-out property <float> volume: 0.6;
    in-out property <bool> expanded;
    // Lyrics (Rust fills `lyrics`; `end-ms` is the next line's start, the last line's the duration).
    // `lyrics-note` is "" while lines exist, otherwise a one-line status. `show-lyrics` is the toggle.
    in property <[LyricLine]> lyrics;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in-out property <bool> show-lyrics: true;
    callback play-pause();
    callback next();
    callback prev();
    callback seek(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback toggle-repeat();
}

// Icons on a 24 grid. Transport glyphs are solid with a 2px round-joined outline (so the corners
// are soft); everything else is a 1.75px round-capped stroke.
global Icons {
    out property <string> play: "M8 5.5 L8 18.5 L19 12 Z";
    out property <string> pause: "M7.5 6 H10.5 V18 H7.5 Z M13.5 6 H16.5 V18 H13.5 Z";
    out property <string> prev: "M5 6.5 H6.5 V17.5 H5 Z M19 6.5 L11 12 L19 17.5 Z";
    out property <string> next: "M19 6.5 H17.5 V17.5 H19 Z M5 6.5 L13 12 L5 17.5 Z";
    out property <string> shuffle: "M3 7 H6 C11 7 13 17 18 17 H20.5 M18.5 14.5 L21 17 L18.5 19.5 M3 17 H6 C7.6 17 8.8 16.4 9.7 15.3 M14.3 8.7 C15.2 7.6 16.4 7 18 7 H20.5 M18.5 4.5 L21 7 L18.5 9.5";
    out property <string> repeat: "M4 12 V10 C4 7.8 5.8 6 8 6 H20 M17 3 L20 6 L17 9 M20 12 V14 C20 16.2 18.2 18 16 18 H4 M7 15 L4 18 L7 21";
    // A speech bubble with two text lines.
    out property <string> lyrics: "M6 4.5 H18 C19.4 4.5 20.5 5.6 20.5 7 V14 C20.5 15.4 19.4 16.5 18 16.5 H11 L7 20 V16.5 H6 C4.6 16.5 3.5 15.4 3.5 14 V7 C3.5 5.6 4.6 4.5 6 4.5 Z M8 9 H16 M8 12 H13";
    out property <string> chevron-up: "M6 15 L12 9 L18 15";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> volume-mute: "M4 9.5 H7.5 L12 5.5 V18.5 L7.5 14.5 H4 Z M16 9.5 L21 14.5 M21 9.5 L16 14.5";
    out property <string> volume-low: "M4 9.5 H7.5 L12 5.5 V18.5 L7.5 14.5 H4 Z M15.5 9.2 A4 4 0 0 1 15.5 14.8";
    out property <string> volume-high: "M4 9.5 H7.5 L12 5.5 V18.5 L7.5 14.5 H4 Z M15.5 9.2 A4 4 0 0 1 15.5 14.8 M18.2 6.8 A8 8 0 0 1 18.2 17.2";
}

global Fmt {
    public pure function two(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }
    // m:ss
    public pure function mmss(ms: int) -> string {
        return "\{Math.floor(Math.max(ms, 0) / 60000)}:\{two(Math.mod(Math.floor(Math.max(ms, 0) / 1000), 60))}";
    }
}

component Icon inherits Path {
    in property <length> size: 20px;
    in property <bool> solid;
    in property <color> tint: Theme.text;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.solid ? root.tint : transparent;
    stroke: root.tint;
    stroke-width: (root.solid ? 2px : 1.75px) * (root.size / 24px);
    stroke-line-cap: round;
    stroke-line-join: round;
    animate fill, stroke { duration: Theme.duration-fast; easing: Theme.ease; }
}

// Quiet icon button: hover and press tint the background, hover brightens the glyph.
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <length> icon-size: 20px;
    in property <bool> solid;
    in property <bool> active;
    in property <color> active-color: Theme.accent;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : 0.35;
    background: !root.enabled ? transparent : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.duration-fast; easing: Theme.ease; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.icon-size;
        solid: root.solid;
        commands: root.commands;
        tint: root.active ? root.active-color : (touch.has-hover && root.enabled) ? Theme.text : Theme.text-secondary;
    }
    // A dot under toggled icons, so state does not rely on colour alone.
    Rectangle {
        visible: root.active;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.active-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height + root.icon-size) / 2 + 2px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// The one prominent control: a near-white disc.
component PlayButton inherits Rectangle {
    in property <length> diameter: 44px;
    in property <bool> enabled: true;
    callback clicked;
    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    opacity: root.enabled ? 1 : 0.35;
    background: (touch.pressed && root.enabled) ? Theme.text-secondary : (touch.has-hover && root.enabled) ? #ffffff : Theme.text;
    animate background { duration: Theme.duration-fast; easing: Theme.ease; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.diameter * 0.5;
        solid: true;
        tint: Theme.bg;
        commands: Playback.playing ? Icons.pause : Icons.play;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Thin slider. While pressed it shows the drag position; `live` fires on every change of the
// drag, `released` once at the end (also for a plain click). `value` is 0..1.
component Scrubber inherits Rectangle {
    in property <float> value;
    in property <color> fill-color: Theme.accent;
    in property <bool> enabled: true;
    out property <bool> dragging: touch.pressed;
    out property <float> shown: touch.pressed ? root.drag : Math.clamp(root.value, 0, 1);
    callback live(float);
    callback released(float);
    property <float> drag;
    property <bool> hot: root.enabled && (touch.has-hover || touch.pressed);
    height: 20px;
    opacity: root.enabled ? 1 : 0.35;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: 2px;
            background: root.fill-color;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        x: root.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: Theme.duration-fast; easing: Theme.ease; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                    root.live(root.drag);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.drag);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.live(root.drag);
            }
        }
    }
}

// 88px tall, any width. Keep exactly one instance alive: it owns the position Timer.
export component NowPlayingBar inherits Rectangle {
    property <bool> idle: Playback.title == "";
    property <color> accent: Playback.accent;
    property <length> centre-w: Math.min(520px, root.width * 0.42);
    property <length> side-w: (root.width - root.centre-w) / 2 - 2 * Theme.space-xl;
    property <float> saved-volume: 0.6;
    property <int> last-sent: -1;
    animate accent { duration: Theme.duration-normal; easing: Theme.ease; }
    height: 88px;
    background: Theme.bg;

    Timer {
        interval: 100ms;
        running: Playback.playing && Playback.duration-ms > 0;
        triggered => {
            Playback.position-ms = Math.min(Playback.position-ms + 100, Playback.duration-ms);
        }
    }

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }

    // Left: art and track, click opens the full view.
    Rectangle {
        x: Theme.space-xl;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: 56px;
        Cover {
            x: 0;
            y: 0;
            width: 56px;
            height: 56px;
            source: Playback.bar-art.width > 0 ? Playback.bar-art : Playback.art;
            radius: Theme.radius-thumb;
            backdrop: Theme.bg;
        }
        VerticalLayout {
            x: 56px + Theme.space-md + 2px;
            width: parent.width - self.x;
            alignment: center;
            spacing: 2px;
            Text {
                text: Playback.title;
                color: Theme.text;
                font-size: Theme.size-body;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }
            Text {
                text: Playback.artist;
                color: Theme.text-secondary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
                overflow: elide;
            }
        }
        TouchArea {
            enabled: !root.idle;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Playback.expanded = true; }
        }
    }

    // Centre: transport above the seek bar.
    VerticalLayout {
        x: (root.width - root.centre-w) / 2;
        y: 10px;
        width: root.centre-w;
        height: 68px;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-sm;
            IconButton {
                y: (parent.height - self.height) / 2;
                commands: Icons.shuffle;
                active: Playback.shuffle;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-shuffle(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                icon-size: 22px;
                solid: true;
                commands: Icons.prev;
                enabled: !root.idle;
                clicked => { Playback.prev(); }
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                diameter: 44px;
                enabled: !root.idle;
                clicked => { Playback.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                icon-size: 22px;
                solid: true;
                commands: Icons.next;
                enabled: !root.idle;
                clicked => { Playback.next(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                commands: Icons.repeat;
                active: Playback.repeat;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-repeat(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-sm;
            Text {
                width: 40px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(seek.dragging ? Math.round(seek.shown * Playback.duration-ms) : Playback.position-ms);
                color: Theme.text-tertiary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
            }
            seek := Scrubber {
                horizontal-stretch: 1;
                value: Playback.duration-ms > 0 ? Playback.position-ms / Playback.duration-ms : 0;
                fill-color: root.accent;
                enabled: !root.idle && Playback.duration-ms > 0;
                released(v) => {
                    Playback.position-ms = Math.round(v * Playback.duration-ms);
                    Playback.seek(Playback.position-ms);
                }
            }
            Text {
                width: 40px;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(Playback.duration-ms);
                color: Theme.text-tertiary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
            }
        }
    }

    // Right: volume (click the speaker to mute) and expand.
    HorizontalLayout {
        x: root.width - Theme.space-xl - root.side-w;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: 36px;
        alignment: end;
        spacing: Theme.space-xs;
        IconButton {
            commands: Icons.lyrics;
            active: Playback.expanded;
            active-color: root.accent;
            enabled: !root.idle;
            clicked => {
                Playback.expanded = !Playback.expanded;
            }
        }
        IconButton {
            commands: Playback.volume <= 0.001 ? Icons.volume-mute : Playback.volume < 0.5 ? Icons.volume-low : Icons.volume-high;
            clicked => {
                if (Playback.volume > 0.001) {
                    root.saved-volume = Playback.volume;
                    Playback.volume = 0;
                } else {
                    Playback.volume = root.saved-volume;
                }
                Playback.set-volume(Playback.volume);
            }
        }
        Scrubber {
            width: Math.max(72px, Math.min(120px, root.side-w - 4 * 36px - 4 * Theme.space-xs));
            y: 8px;
            value: Playback.volume;
            fill-color: root.accent;
            live(v) => {
                Playback.volume = v;
                if (Math.round(v * 100) != root.last-sent) {
                    root.last-sent = Math.round(v * 100);
                    Playback.set-volume(v);
                }
            }
            released(v) => {
                Playback.volume = v;
                Playback.set-volume(v);
            }
        }
        IconButton {
            commands: Playback.expanded ? Icons.chevron-down : Icons.chevron-up;
            icon-size: 22px;
            enabled: !root.idle || Playback.expanded;
            clicked => { Playback.expanded = !Playback.expanded; }
        }
    }
}

// One visual row of the karaoke line: the words assigned to `row`, letters lighting in turn.
component LyricWordRow inherits HorizontalLayout {
    in property <[LyricWord]> words;
    in property <int> row-index;
    in property <length> font-size;
    spacing: 0px;
    for word in root.words : HorizontalLayout {
        visible: word.row == root.row-index;
        spacing: 0px;
        for letter in word.letters : Text {
            text: letter.ch;
            color: Playback.position-ms >= letter.start-ms ? #ffffff : #ffffff.mix(transparent, 68%);
            font-size: root.font-size;
            letter-spacing: -0.6px;
            font-weight: Theme.weight-bold;
        }
        Text {
            text: " ";
            font-size: root.font-size;
            font-weight: Theme.weight-bold;
        }
    }
}

// One lyric line. `state`: -1 sung, 0 current, 1 coming up, 2 plain (unsynced).
// Sizing is handed in by LyricsPanel and scales with the window: rows are tall enough
// for a wrapped two-line lyric, and lines wrap instead of truncating with "...".
component LyricRow inherits Rectangle {
    in property <LyricLine> line;
    in property <int> state;
    in property <bool> clickable;
    in property <length> active-size: 42px;
    in property <length> other-size: 26px;
    in property <length> row-height: 105px;
    callback clicked;
    height: root.row-height;
    border-radius: Theme.radius-control;
    background: (root.clickable && touch.has-hover) ? Theme.hover : transparent;
    animate background { duration: Theme.duration-fast; easing: Theme.ease; }

    // Word-by-word karaoke (yoshik.xyz): the active line renders per-letter; letters light
    // as position-ms passes each letter's threshold (precomputed in Rust).
    property <bool> word-mode: root.state == 0 && root.line.words.length > 0;

    Text {
        visible: !root.word-mode;
        x: Theme.space-sm;
        y: 0px;
        width: parent.width - 2 * Theme.space-sm;
        height: parent.height;
        vertical-alignment: center;
        text: root.line.text;
        wrap: word-wrap;
        // Never truncate a lyric line with "...": long lines wrap onto a second line
        // and the row is sized for two lines, so nothing is clipped.
        font-size: root.state == 0 ? root.active-size : root.other-size;
        letter-spacing: root.state == 0 ? -0.6px : -0.3px;
        font-weight: Theme.weight-bold;
        color: root.state == 0 ? #ffffff : root.state < 0 ? #ffffff.mix(transparent, 55%) : root.state == 1 ? #ffffff.mix(transparent, 68%) : #ffffff;
        animate font-size, color { duration: Theme.duration-fast; easing: Theme.ease; }
    }

    // Word flow for the active line: letters light one by one, words wrap like the plain text.
    // Words are pre-split into at most two visual rows in Rust (build_lyric_words) from the
    // real window width, so a long line wraps instead of truncating or clipping.
    // Two rows fill the row (2.5x the active font); a single row is vertically centered.
    VerticalLayout {
        visible: root.word-mode;
        x: Theme.space-sm;
        y: (parent.height - root.line.word-rows * root.active-size * 1.25) / 2;
        width: parent.width - 2 * Theme.space-sm;
        spacing: 0px;
        LyricWordRow { words: root.line.words; row-index: 0; font-size: root.active-size; }
        LyricWordRow { words: root.line.words; row-index: 1; font-size: root.active-size; visible: root.line.word-rows > 1; }
    }
    touch := TouchArea {
        enabled: root.clickable && root.line.text != "";
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Synced lyrics follow `position-ms`: the current line is vertically centered at the screen midpoint.
// A manual scroll pauses auto-follow for 4 s.
component LyricsPanel inherits Rectangle {
    property <int> n: Playback.lyrics.length;
    property <int> pos: Playback.position-ms;
    property <bool> synced: Playback.lyrics-synced;
    property <string> track: Playback.title;
    property <length> vh: list.visible-height;
    // Type scales with the panel width so fullscreen and windowed both fit: full 42px
    // at wide sizes, shrinking to 65% at narrow ones. Row height is 2.5x the active
    // font size, so a line that wraps onto two lines still fits inside its row.
    property <float> scale: Math.clamp(root.width / 900px, 0.65, 1.0);
    property <length> active-size: 42px * root.scale;
    property <length> other-size: 26px * root.scale;
    property <length> row-h: root.active-size * 2.5;
    property <int> active: -1;
    property <int> probe: -1;
    property <bool> paused;
    property <duration> resume-at;

    function locate() {
        if (!Playback.lyrics-synced || Playback.lyrics.length == 0) {
            root.active = -1;
            return;
        }
        root.probe = -1;
        if (root.probe + 1024 < Playback.lyrics.length && Playback.lyrics[root.probe + 1024].start-ms <= Playback.position-ms) { root.probe += 1024; }
        if (root.probe + 512 < Playback.lyrics.length && Playback.lyrics[root.probe + 512].start-ms <= Playback.position-ms) { root.probe += 512; }
        if (root.probe + 256 < Playback.lyrics.length && Playback.lyrics[root.probe + 256].start-ms <= Playback.position-ms) { root.probe += 256; }
        if (root.probe + 128 < Playback.lyrics.length && Playback.lyrics[root.probe + 128].start-ms <= Playback.position-ms) { root.probe += 128; }
        if (root.probe + 64 < Playback.lyrics.length && Playback.lyrics[root.probe + 64].start-ms <= Playback.position-ms) { root.probe += 64; }
        if (root.probe + 32 < Playback.lyrics.length && Playback.lyrics[root.probe + 32].start-ms <= Playback.position-ms) { root.probe += 32; }
        if (root.probe + 16 < Playback.lyrics.length && Playback.lyrics[root.probe + 16].start-ms <= Playback.position-ms) { root.probe += 16; }
        if (root.probe + 8 < Playback.lyrics.length && Playback.lyrics[root.probe + 8].start-ms <= Playback.position-ms) { root.probe += 8; }
        if (root.probe + 4 < Playback.lyrics.length && Playback.lyrics[root.probe + 4].start-ms <= Playback.position-ms) { root.probe += 4; }
        if (root.probe + 2 < Playback.lyrics.length && Playback.lyrics[root.probe + 2].start-ms <= Playback.position-ms) { root.probe += 2; }
        if (root.probe + 1 < Playback.lyrics.length && Playback.lyrics[root.probe + 1].start-ms <= Playback.position-ms) { root.probe += 1; }
        root.active = root.probe;
    }

    // Exact vertical centering matching yoshik.xyz: scrollTarget = row.offsetTop + row.height / 2 - list.height / 2
    function follow() {
        if (root.paused || !Playback.lyrics-synced) {
            return;
        }
        list.content-y = root.vh / 2 - root.row-h / 2 - Math.max(root.active, 0) * root.row-h;
    }

    changed pos => { root.locate(); }
    changed synced => {
        root.locate();
        root.follow();
    }
    changed active => { root.follow(); }
    changed vh => { root.follow(); }
    // Resize / fullscreen toggle changes row-h (type scales with width): re-center so the
    // active line never sits at a stale offset or clipped against the viewport edge.
    changed row-h => { root.follow(); }
    changed track => { root.restart(); }
    changed n => { root.restart(); }
    function restart() {
        root.paused = false;
        root.locate();
        list.content-y = 0px;
        root.follow();
    }

    Timer {
        interval: 500ms;
        running: root.paused;
        triggered => {
            if (animation-tick() >= root.resume-at) {
                root.paused = false;
                root.follow();
            }
        }
    }

    list := ListView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        visible: root.n > 0;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        animate content-y { duration: Theme.duration-normal; easing: Theme.ease; }
        scrolled => {
            root.paused = true;
            root.resume-at = animation-tick() + 4s;
        }
        for line[i] in Playback.lyrics : LyricRow {
            line: line;
            active-size: root.active-size;
            other-size: root.other-size;
            row-height: root.row-h;
            state: !root.synced ? 2 : i < root.active ? -1 : i == root.active ? 0 : 1;
            clickable: root.synced;
            clicked => {
                Playback.position-ms = line.start-ms;
                Playback.seek(line.start-ms);
            }
        }
    }

    Text {
        visible: root.n == 0;
        x: Theme.space-md;
        y: (parent.height - self.height) / 2;
        width: parent.width - 2 * Theme.space-md;
        horizontal-alignment: center;
        text: Playback.lyrics-note;
        color: Theme.text-secondary;
        font-size: Theme.size-heading;
        wrap: word-wrap;
    }
}

// Fullscreen Now Playing overlay: exact match to yoshik.xyz / lyrics overlay
export component NowPlayingView inherits Rectangle {
    property <bool> idle: Playback.title == "";
    property <color> accent: Playback.accent;
    property <length> side-w: Math.max(260px, Math.min(520px, root.width * 0.36));
    property <length> side-x: Math.max(36px, root.width * 0.06);
    property <length> side-y: (root.height - (root.side-w + 80px)) / 2;

    visible: root.opacity > 0.01;
    // Ambient radial glow matching yoshik.xyz
    background: @radial-gradient(circle, root.accent.mix(#000000, 0.40) 0%, root.accent.mix(#000000, 0.75) 50%, #08080a 100%);
    animate accent { duration: Theme.duration-normal; easing: Theme.ease; }

    TouchArea { }

    IconButton {
        x: Theme.space-xl;
        y: Theme.space-xl;
        width: 40px;
        height: 40px;
        icon-size: 26px;
        commands: Icons.chevron-down;
        clicked => { Playback.expanded = false; }
    }

    // Left column: Cover art, title, artist, progress bar (matches .lyrics-side)
    Rectangle {
        x: root.side-x;
        y: root.side-y;
        width: root.side-w;
        height: root.side-w + 80px;

        Cover {
            x: 0px;
            y: 0px;
            width: root.side-w;
            height: root.side-w;
            source: Playback.art;
            radius: 14px;
            backdrop: root.accent.mix(#000000, 0.45);
            backdrop-bottom: root.accent.mix(#000000, 0.65);
        }

        // Title under art
        Text {
            x: 0px;
            y: root.side-w + 16px;
            width: root.side-w;
            height: 22px;
            text: Playback.title;
            color: #ffffff;
            font-size: 17px;
            font-weight: Theme.weight-bold;
            overflow: elide;
        }

        // Artist under title
        Text {
            x: 0px;
            y: root.side-w + 39px;
            width: root.side-w;
            height: 18px;
            text: Playback.artist;
            color: rgba(255, 255, 255, 0.55);
            font-size: 14px;
            font-weight: Theme.weight-medium;
            overflow: elide;
        }

        // Progress bar under artist
        Rectangle {
            x: 0px;
            y: root.side-w + 64px;
            width: root.side-w;
            height: 5px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.14);
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                height: 100%;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.85);
                width: Playback.duration-ms > 0 ? parent.width * Math.min(1.0, Math.max(0.0, Playback.position-ms / Playback.duration-ms)) : 0px;
            }

            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if (Playback.duration-ms > 0) {
                        Playback.seek(Math.floor(Math.clamp(self.mouse-x / parent.width, 0.0, 1.0) * Playback.duration-ms));
                    }
                }
            }
        }
    }

    // Right column: Full viewport height lyrics (matches .lyrics-lines)
    Rectangle {
        x: root.side-x + root.side-w + Math.max(36px, root.width * 0.05);
        y: 0px;
        width: root.width - self.x - root.side-x;
        height: root.height;
        clip: true;

        LyricsPanel {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }

        // Soft top fade
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 80px;
            background: @linear-gradient(180deg, #08080a 0%, transparent 100%);
        }

        // Soft bottom fade
        Rectangle {
            x: 0px;
            y: parent.height - 80px;
            width: parent.width;
            height: 80px;
            background: @linear-gradient(0deg, #08080a 0%, transparent 100%);
        }
    }
}
