// Now playing: the `Playback` state global (Rust writes it, the UI reads it), the bottom bar and
// the expanded view. Rust sets `position-ms` on player events; the bar's Timer only interpolates
// between events. Nothing here takes keyboard focus.
import { Theme } from "theme.slint";
import { Cover } from "cover.slint";


// Lyrics, pre-laid-out by Rust (src/lyrics_view.rs) for the current window width.
export struct LyrLetter {
    ch: string,
    // lyric-ms at which the letter lights (the word's window split evenly across its letters).
    at: int,
}

export struct LyrWord {
    letters: [LyrLetter],
    // A space follows this word on its row.
    space: bool,
}

export struct LyrRow {
    words: [LyrWord],
}

export struct LyrLine {
    start-ms: int,
    // The line wrapped at the normal size, and at the active size.
    rows: [string],
    arows: [string],
    // Per-letter rows at the active size; empty without word timings.
    wrows: [LyrRow],
    // Offset of the line's top from the first line's top (all earlier lines inactive), its height
    // inactive and active. Includes the 16px top and bottom padding.
    top: length,
    h: length,
    ah: length,
}

// One karaoke word slot, split in two so a frame never touches the texture: KWord changes only
// when another word takes the slot (or its colour state changes); KMotion changes every frame.
// The word is a texture rasterized once (Rust) at the base em; the GPU scales and tilts it.
export struct KWord {
    img: image,
    // Texture size, where it sits in the element box, the text advance width and the base em.
    iw: length,
    ih: length,
    ix: length,
    iy: length,
    tw: length,
    base: length,
    // Highlight tilt (deg), text colour for the state, glyph.
    tilt: float,
    color: color,
    icon: string,
    icon-left: bool,
}

export struct KMotion {
    // Centre in window px, scale relative to the base em, tilt (deg), paint order.
    x: length,
    y: length,
    scale: float,
    rot: float,
    z: float,
    opacity: float,
    // Highlight box opacity, scale and slide (em); glyph scale and turn.
    hl: float,
    hl-sx: float,
    hl-sy: float,
    hl-dx: float,
    icon-scale: float,
    icon-rot: float,
}

export global Playback {
    in-out property <string> title;
    in-out property <string> artist;
    in-out property <string> album;
    in-out property <image> art;
    // Optional extra: a 56px-sized copy for the bar (crisper than scaling `art` down). Unset, the bar uses `art`.
    in-out property <image> bar-art;
    // Lyrics page: the art with its corners rounded in alpha, a 44px copy, and a tiny blurred copy.
    in property <image> side-art;
    in property <image> thumb-art;
    in property <image> bg-art;
    in-out property <color> accent: Theme.accent;
    // Rust owns the clock: it writes position-ms from a monotonic anchor, never from a UI timer.
    in-out property <int> position-ms;
    in-out property <int> duration-ms;
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <bool> repeat;
    in-out property <float> volume: 0.6;
    in-out property <bool> expanded;
    // The context (playlist / album / liked) the current track was started from.
    in property <string> context-uri;

    // Lyrics page.
    in property <[LyrLine]> lyr-lines;
    in property <bool> lyr-synced;
    in property <length> lyr-total-h;
    in property <int> lyr-active: -1;
    in property <string> lyr-hint;
    // The lyrics clock: position-ms, refreshed when the next letter or line is due.
    in property <int> lyric-ms;
    // Karaoke exists only in builds with the `karaoke` feature (`karaoke-allowed`).
    in property <bool> karaoke-allowed;
    in property <bool> karaoke-available;
    in property <bool> karaoke;
    in property <string> k-style: "visual";
    in property <color> k-lyric: #ffffff;
    in property <color> k-highlight: #ff3d8b;
    in property <color> k-secondary: #d6906c;
    in property <[KWord]> k-words;
    in property <[KMotion]> k-motion;
    in property <image> k-bg;

    callback play-pause();
    callback next();
    callback prev();
    callback seek(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback toggle-repeat();
    callback open-context();
    callback set-karaoke(bool);
    callback set-k-style(string);
    callback cycle-color(string, int);
    callback reset-k-colors();
}

// Icons on a 24 grid. Transport glyphs are solid shapes with rounded corners; everything else is
// a round-capped stroke.
export global Icons {
    out property <string> play: "M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z";
    out property <string> pause: "M7 5h2.5a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M14.5 5H17a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2.5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z";
    out property <string> prev: "M6 5a1 1 0 0 1 1 1v12a1 1 0 0 1-2 0V6a1 1 0 0 1 1-1z M19 6.2v11.6a1 1 0 0 1-1.55.83l-8.7-5.8a1 1 0 0 1 0-1.66l8.7-5.8A1 1 0 0 1 19 6.2z";
    out property <string> next: "M18 5a1 1 0 0 1 1 1v12a1 1 0 0 1-2 0V6a1 1 0 0 1 1-1z M5 6.2v11.6a1 1 0 0 0 1.55.83l8.7-5.8a1 1 0 0 0 0-1.66l-8.7-5.8A1 1 0 0 0 5 6.2z";
    out property <string> shuffle: "M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22 M18 2l4 4-4 4 M2 6h1.9c1.5 0 2.9.9 3.6 2.2 M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8 M18 14l4 4-4 4";
    out property <string> repeat: "M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3";
    out property <string> lyrics: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z M13 8H7 M17 12H7";
    out property <string> playlist: "M21 15V6 M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z M12 12H3 M16 6H3 M12 18H3";
    out property <string> home: "M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    out property <string> search: "M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M21 21l-4.3-4.3";
    out property <string> heart: "M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z";
    out property <string> chevron-up: "M6 15 L12 9 L18 15";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> volume-mute: "M11 4.7a.7.7 0 0 0-1.2-.5L6.4 7.6A1.4 1.4 0 0 1 5.4 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.4a1.4 1.4 0 0 1 1 .4l3.4 3.4a.7.7 0 0 0 1.2-.5z M22 9l-6 6 M16 9l6 6";
    out property <string> volume-low: "M11 4.7a.7.7 0 0 0-1.2-.5L6.4 7.6A1.4 1.4 0 0 1 5.4 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.4a1.4 1.4 0 0 1 1 .4l3.4 3.4a.7.7 0 0 0 1.2-.5z M16 9a5 5 0 0 1 0 6";
    out property <string> volume-high: "M11 4.7a.7.7 0 0 0-1.2-.5L6.4 7.6A1.4 1.4 0 0 1 5.4 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.4a1.4 1.4 0 0 1 1 .4l3.4 3.4a.7.7 0 0 0 1.2-.5z M16 9a5 5 0 0 1 0 6 M19.4 18.4a9 9 0 0 0 0-12.8";
    out property <string> mic: "M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z M19 10v2a7 7 0 0 1-14 0v-2 M12 19L12 22";
}

global Fmt {
    public pure function two(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }
    // m:ss
    public pure function mmss(ms: int) -> string {
        return "\{Math.floor(Math.max(ms, 0) / 60000)}:\{two(Math.mod(Math.floor(Math.max(ms, 0) / 1000), 60))}";
    }
}

component Icon inherits Path {
    in property <length> size: 20px;
    in property <bool> solid;
    in property <color> tint: Theme.text;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.solid ? root.tint : transparent;
    stroke: root.tint;
    stroke-width: (root.solid ? 0.6px : 1.75px) * (root.size / 24px);
    stroke-line-cap: round;
    stroke-line-join: round;
    animate fill, stroke { duration: Theme.duration-fast; easing: Theme.ease; }
}

// Quiet icon button: hover and press tint the background, hover brightens the glyph.
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <length> icon-size: 20px;
    in property <bool> solid;
    in property <bool> active;
    in property <color> active-color: Theme.accent;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px;
    height: 36px;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : 0.35;
    background: !root.enabled ? transparent : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.duration-fast; easing: Theme.ease; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.icon-size;
        solid: root.solid;
        commands: root.commands;
        tint: root.active ? root.active-color : (touch.has-hover && root.enabled) ? Theme.text : Theme.text-secondary;
    }
    // A dot under toggled icons, so state does not rely on colour alone.
    Rectangle {
        visible: root.active;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: root.active-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height + root.icon-size) / 2 + 2px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// The one prominent control: a near-white disc.
component PlayButton inherits Rectangle {
    in property <length> diameter: 44px;
    in property <bool> enabled: true;
    callback clicked;
    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    opacity: root.enabled ? 1 : 0.35;
    background: (touch.pressed && root.enabled) ? Theme.text-secondary : (touch.has-hover && root.enabled) ? #ffffff : Theme.text;
    animate background { duration: Theme.duration-fast; easing: Theme.ease; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.diameter * 0.5;
        solid: true;
        tint: Theme.bg;
        commands: Playback.playing ? Icons.pause : Icons.play;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Thin slider. While pressed it shows the drag position; `live` fires on every change of the
// drag, `released` once at the end (also for a plain click). `value` is 0..1.
component Scrubber inherits Rectangle {
    in property <float> value;
    in property <color> fill-color: Theme.accent;
    in property <bool> enabled: true;
    out property <bool> dragging: touch.pressed;
    out property <float> shown: touch.pressed ? root.drag : Math.clamp(root.value, 0, 1);
    callback live(float);
    callback released(float);
    property <float> drag;
    property <bool> hot: root.enabled && (touch.has-hover || touch.pressed);
    height: 20px;
    opacity: root.enabled ? 1 : 0.35;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: 2px;
            background: root.fill-color;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        x: root.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: Theme.duration-fast; easing: Theme.ease; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                    root.live(root.drag);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.drag);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.live(root.drag);
            }
        }
    }
}

// 88px tall, any width.
export component NowPlayingBar inherits Rectangle {
    property <bool> idle: Playback.title == "";
    property <color> accent: Playback.accent;
    property <length> centre-w: Math.min(520px, root.width * 0.42);
    property <length> side-w: (root.width - root.centre-w) / 2 - 2 * Theme.space-xl;
    property <float> saved-volume: 0.6;
    property <int> last-sent: -1;
    animate accent { duration: Theme.duration-normal; easing: Theme.ease; }
    height: 88px;
    background: Theme.bg;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.divider;
    }

    // Left: art and track, click opens the full view.
    Rectangle {
        x: Theme.space-xl;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: 56px;
        Cover {
            x: 0;
            y: 0;
            width: 56px;
            height: 56px;
            source: Playback.bar-art.width > 0 ? Playback.bar-art : Playback.art;
            radius: Theme.radius-thumb;
            backdrop: Theme.bg;
        }
        VerticalLayout {
            x: 56px + Theme.space-md + 2px;
            width: parent.width - self.x;
            alignment: center;
            spacing: 2px;
            Text {
                text: Playback.title;
                color: Theme.text;
                font-size: Theme.size-body;
                font-weight: Theme.weight-semibold;
                overflow: elide;
            }
            Text {
                text: Playback.artist;
                color: Theme.text-secondary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
                overflow: elide;
            }
        }
        TouchArea {
            enabled: !root.idle;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Playback.expanded = true; }
        }
    }

    // Centre: transport above the seek bar.
    VerticalLayout {
        x: (root.width - root.centre-w) / 2;
        y: 10px;
        width: root.centre-w;
        height: 68px;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-sm;
            IconButton {
                y: (parent.height - self.height) / 2;
                commands: Icons.shuffle;
                active: Playback.shuffle;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-shuffle(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                icon-size: 22px;
                solid: true;
                commands: Icons.prev;
                enabled: !root.idle;
                clicked => { Playback.prev(); }
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                diameter: 44px;
                enabled: !root.idle;
                clicked => { Playback.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                icon-size: 22px;
                solid: true;
                commands: Icons.next;
                enabled: !root.idle;
                clicked => { Playback.next(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                commands: Icons.repeat;
                active: Playback.repeat;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-repeat(); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-sm;
            Text {
                width: 40px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(seek.dragging ? Math.round(seek.shown * Playback.duration-ms) : Playback.position-ms);
                color: Theme.text-tertiary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
            }
            seek := Scrubber {
                horizontal-stretch: 1;
                value: Playback.duration-ms > 0 ? Playback.position-ms / Playback.duration-ms : 0;
                fill-color: root.accent;
                enabled: !root.idle && Playback.duration-ms > 0;
                released(v) => {
                    Playback.position-ms = Math.round(v * Playback.duration-ms);
                    Playback.seek(Playback.position-ms);
                }
            }
            Text {
                width: 40px;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(Playback.duration-ms);
                color: Theme.text-tertiary;
                font-size: Theme.size-caption;
                letter-spacing: Theme.tracking-caption;
            }
        }
    }

    // Right: volume (click the speaker to mute) and expand.
    HorizontalLayout {
        x: root.width - Theme.space-xl - root.side-w;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: 36px;
        alignment: end;
        spacing: Theme.space-xs;
        // Opens the playlist / album the current track was started from.
        IconButton {
            commands: Icons.playlist;
            enabled: Playback.context-uri != "";
            clicked => { Playback.open-context(); }
        }
        IconButton {
            commands: Icons.lyrics;
            active: Playback.expanded;
            active-color: root.accent;
            enabled: !root.idle;
            clicked => {
                Playback.expanded = !Playback.expanded;
            }
        }
        IconButton {
            commands: Playback.volume <= 0.001 ? Icons.volume-mute : Playback.volume < 0.5 ? Icons.volume-low : Icons.volume-high;
            clicked => {
                if (Playback.volume > 0.001) {
                    root.saved-volume = Playback.volume;
                    Playback.volume = 0;
                } else {
                    Playback.volume = root.saved-volume;
                }
                Playback.set-volume(Playback.volume);
            }
        }
        Scrubber {
            width: Math.max(72px, Math.min(120px, root.side-w - 4 * 36px - 4 * Theme.space-xs));
            y: 8px;
            value: Playback.volume;
            fill-color: root.accent;
            live(v) => {
                Playback.volume = v;
                if (Math.round(v * 100) != root.last-sent) {
                    root.last-sent = Math.round(v * 100);
                    Playback.set-volume(v);
                }
            }
            released(v) => {
                Playback.volume = v;
                Playback.set-volume(v);
            }
        }
    }
}
