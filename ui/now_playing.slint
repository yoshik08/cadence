// "Artist A, Artist B": each name its own link, commas plain. A long list elides the names
// that do not fit, and each visible name stays clickable. No links (local files, episodes):
// the plain `fallback` text.
export component ArtistLinks inherits HorizontalLayout {
    in property <[ArtistLink]> artists;
    in property <string> fallback;
    in property <color> color: Tokens.text-secondary;
    in property <length> font-size: Tokens.size-caption;
    callback open(string);
    spacing: 0px;
    alignment: start;
    if root.artists.length == 0 : Text {
        text: root.fallback;
        color: root.color;
        font-size: root.font-size;
        letter-spacing: Tokens.tracking-caption;
        overflow: elide;
        min-width: 0px;
    }
    for a[i] in root.artists : HorizontalLayout {
        spacing: 0px;
        min-width: 0px;
        if i > 0 : Text {
            text: ", ";
            color: root.color;
            font-size: root.font-size;
            horizontal-stretch: 0;
        }
        Link {
            text: a.name;
            enabled: a.uri != "";
            ink: root.color;
            hover-ink: Tokens.text-primary;
            font-size: root.font-size;
            clicked => { root.open(a.uri); }
        }
    }
}

global Fmt {
    public pure function two(n: int) -> string {
        return n < 10 ? "0\{n}" : "\{n}";
    }
    // m:ss
    public pure function mmss(ms: int) -> string {
        return "\{Math.floor(Math.max(ms, 0) / 60000)}:\{two(Math.mod(Math.floor(Math.max(ms, 0) / 1000), 60))}";
    }
}

// The one prominent control: a near-white disc.
export component PlayButton inherits Rectangle {
    in property <length> diameter: Tokens.control-lg;
    in property <bool> enabled: true;
    callback clicked;
    width: root.diameter;
    height: root.diameter;
    border-radius: Tokens.radius-full;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    background: (touch.pressed && root.enabled) ? Tokens.bg-inverse-pressed : (touch.has-hover && root.enabled) ? Tokens.bg-inverse-hover : Tokens.bg-inverse;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }

    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.diameter * 0.5;
        solid: true;
        tint: Tokens.text-inverse;
        commands: Playback.playing ? Icons.pause : Icons.play;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Thin slider. While pressed it shows the drag position; `live` fires on every change of the
// drag, `released` once at the end (also for a plain click). `value` is 0..1.
export component Scrubber inherits Rectangle {
    in property <float> value;
    in property <color> fill-color: Tokens.accent;
    in property <bool> enabled: true;
    out property <bool> dragging: touch.pressed;
    out property <float> shown: touch.pressed ? root.drag : Math.clamp(root.value, 0, 1);
    callback live(float);
    callback released(float);
    property <float> drag;
    property <bool> hot: root.enabled && (touch.has-hover || touch.pressed);
    property <length> thumb: Tokens.icon-xs;
    height: Tokens.icon-md;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: Tokens.track-height;
        border-radius: Tokens.radius-full;
        background: Tokens.bg-track;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: Tokens.radius-full;
            background: root.fill-color;
        }
    }
    Rectangle {
        width: root.thumb;
        height: root.thumb;
        border-radius: Tokens.radius-full;
        background: Tokens.text-bright;
        x: root.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                    root.live(root.drag);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.drag);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                root.live(root.drag);
            }
        }
    }
}

// A text button in the bar (podcast speed, sleep timer): quiet until hovered.
component BarChip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <color> ink: Tokens.text-secondary;
    callback clicked-at(length, length);
    property <bool> has-icon: root.icon != "";
    width: (root.has-icon ? Tokens.control-md : Tokens.space-md) + (root.text != "" ? label.preferred-width + Tokens.space-md : 0px);
    height: Tokens.control-md;
    border-radius: Tokens.radius-md;
    background: touch.pressed ? Tokens.bg-pressed : touch.has-hover ? Tokens.bg-hover : transparent;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    if root.has-icon : Glyph {
        x: (Tokens.control-md - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-md;
        commands: root.icon;
        tint: root.ink == Tokens.text-secondary && touch.has-hover ? Tokens.text-primary : root.ink;
    }
    label := Text {
        x: root.has-icon ? Tokens.control-md - Tokens.space-2xs : Tokens.space-md;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        color: root.ink;
        font-size: Tokens.size-caption;
        font-weight: Tokens.weight-semibold;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked-at(self.absolute-position.x, self.absolute-position.y - Tokens.space-sm); }
    }
}

// The bottom bar: Tokens.bar-height tall, any width.
export component NowPlayingBar inherits Rectangle {
    property <bool> idle: Playback.title == "";
    property <color> accent: Playback.accent;
    // The transport block is at most this wide, and at most this share of the bar.
    property <length> centre-max: 520px;
    property <float> centre-share: 0.42;
    property <length> centre-w: Math.min(root.centre-max, root.width * root.centre-share);
    property <length> side-w: (root.width - root.centre-w) / 2 - 2 * Tokens.space-xl;
    // Transport row plus seek row.
    property <length> centre-h: 68px;
    property <length> time-width: 40px;
    // Below this side width the panel and mini-player buttons are dropped.
    property <length> roomy-from: 296px;
    property <length> volume-min: 56px;
    property <length> volume-max: 120px;
    // The "1" badge on Repeat one.
    property <length> badge: Tokens.icon-xs;
    property <float> saved-volume: 0.6;
    property <int> last-sent: -1;
    animate accent { duration: Tokens.duration-base; easing: Tokens.ease-out; }
    height: Tokens.bar-height;
    background: Tokens.bg-base;

    Rectangle {
        y: 0;
        height: Tokens.hairline;
        background: Tokens.border;
    }

    // Left: cover (opens / closes lyrics) | title (album) over artists (each its own page) | heart.
    // One start-aligned row, so the heart sits right after the text, not at the section's end.
    HorizontalLayout {
        x: Tokens.space-xl;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: Tokens.art-thumb;
        spacing: Tokens.space-md;
        alignment: start;
        Rectangle {
            width: Tokens.art-thumb;
            horizontal-stretch: 0;
            Cover {
                width: parent.width;
                height: parent.height;
                source: Playback.bar-art.width > 0 ? Playback.bar-art : Playback.art;
                radius: Tokens.radius-md;
                backdrop: Tokens.bg-base;
                fade: Playback.art-fresh;
                placeholder: root.idle ? Tokens.bg-surface : Tokens.art-placeholder;
            }
            TouchArea {
                enabled: !root.idle;
                mouse-cursor: MouseCursor.pointer;
                clicked => { Playback.expanded = !Playback.expanded; }
                pointer-event(e) => {
                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                        Playback.track-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Tokens.space-2xs;
            min-width: 0px;
            // Content width, up to what is left of the section.
            max-width: self.preferred-width;
            horizontal-stretch: 1;
            Link {
                text: Playback.title;
                enabled: Playback.album-uri != "";
                ink: Tokens.text-primary;
                hover-ink: Tokens.text-bright;
                font-size: Tokens.size-body;
                font-weight: Tokens.weight-semibold;
                clicked => { Playback.open-uri(Playback.album-uri); }
            }
            ArtistLinks {
                artists: Playback.artists;
                fallback: Playback.artist;
                open(uri) => { Playback.open-uri(uri); }
            }
            if Playback.autoplaying && !root.idle : Text {
                text: "Autoplaying similar songs";
                font-size: Tokens.size-caption;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }
        if Playback.like-known && !root.idle : IconButton {
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            icon: Icons.heart;
            solid: Playback.liked;
            active: Playback.liked;
            active-color: root.accent;
            clicked => { Playback.toggle-like(); }
        }
    }

    // Centre: transport above the seek bar.
    VerticalLayout {
        x: (root.width - root.centre-w) / 2;
        y: (root.height - root.centre-h) / 2;
        width: root.centre-w;
        height: root.centre-h;
        spacing: Tokens.space-xs;
        HorizontalLayout {
            alignment: center;
            spacing: Tokens.space-sm;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.shuffle;
                active: Playback.shuffle;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-shuffle(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: Tokens.control-lg;
                icon-size: Tokens.icon-lg;
                solid: true;
                icon: Icons.prev;
                enabled: !root.idle;
                clicked => { Playback.prev(); }
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                enabled: !root.idle;
                clicked => { Playback.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: Tokens.control-lg;
                icon-size: Tokens.icon-lg;
                solid: true;
                icon: Icons.next;
                enabled: !root.idle;
                clicked => { Playback.next(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.repeat;
                active: Playback.repeat > 0;
                active-color: root.accent;
                enabled: !root.idle;
                clicked => { Playback.toggle-repeat(); }
                // Repeat one.
                if Playback.repeat == 2 : Rectangle {
                    x: parent.width - root.badge - Tokens.space-2xs;
                    y: Tokens.space-2xs;
                    width: root.badge;
                    height: root.badge;
                    border-radius: Tokens.radius-full;
                    background: root.accent;
                    Text {
                        text: "1";
                        font-size: Tokens.size-micro;
                        font-weight: Tokens.weight-bold;
                        color: Tokens.on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: Tokens.space-sm;
            Text {
                width: root.time-width;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(seek.dragging ? Math.round(seek.shown * Playback.duration-ms) : Playback.position-ms);
                color: Tokens.text-tertiary;
                font-size: Tokens.size-caption;
                letter-spacing: Tokens.tracking-caption;
            }
            seek := Scrubber {
                horizontal-stretch: 1;
                value: Playback.duration-ms > 0 ? Playback.position-ms / Playback.duration-ms : 0;
                fill-color: root.accent;
                enabled: !root.idle && Playback.duration-ms > 0;
                released(v) => {
                    Playback.position-ms = Math.round(v * Playback.duration-ms);
                    Playback.seek(Playback.position-ms);
                }
            }
            Text {
                width: root.time-width;
                vertical-alignment: center;
                text: root.idle ? "" : Fmt.mmss(Playback.duration-ms);
                color: Tokens.text-tertiary;
                font-size: Tokens.size-caption;
                letter-spacing: Tokens.tracking-caption;
            }
        }
    }

    // Right: volume (click the speaker to mute) and expand.
    HorizontalLayout {
        x: root.width - Tokens.space-xl - root.side-w;
        y: (root.height - self.height) / 2;
        width: root.side-w;
        height: Tokens.control-md;
        alignment: end;
        spacing: Tokens.space-xs;
        if Playback.is-episode : BarChip {
            text: Playback.speed == 1 ? "1×" : Math.round(Playback.speed * 100) / 100 + "×";
            ink: Playback.speed == 1 ? Tokens.text-secondary : root.accent;
            clicked-at(x, y) => { Playback.speed-menu(x, y); }
        }
        BarChip {
            icon: Icons.moon;
            text: Playback.sleep-label;
            ink: Playback.sleep-label != "" ? root.accent : Tokens.text-secondary;
            clicked-at(x, y) => { Playback.sleep-menu(x, y); }
        }
        IconButton {
            icon: Icons.queue;
            active: Playback.queue-open;
            active-color: root.accent;
            clicked => { Playback.toggle-queue(); }
        }
        if root.side-w >= root.roomy-from : IconButton {
            icon: Icons.music;
            active: Playback.side-open;
            active-color: root.accent;
            clicked => { Playback.side-open = !Playback.side-open; }
        }
        if root.side-w >= root.roomy-from : IconButton {
            icon: Icons.mini;
            clicked => { Playback.mini-player(); }
        }
        IconButton {
            icon: Icons.lyrics;
            active: Playback.expanded;
            active-color: root.accent;
            enabled: !root.idle;
            clicked => {
                Playback.expanded = !Playback.expanded;
            }
        }
        IconButton {
            icon: Playback.volume <= 0.001 ? Icons.volume-mute : Playback.volume < 0.5 ? Icons.volume-low : Icons.volume-high;
            clicked => {
                if (Playback.volume > 0.001) {
                    root.saved-volume = Playback.volume;
                    Playback.volume = 0;
                } else {
                    Playback.volume = root.saved-volume;
                }
                Playback.set-volume(Playback.volume);
            }
        }
        Scrubber {
            width: Math.max(root.volume-min, Math.min(root.volume-max, root.side-w - 7 * Tokens.control-md - 7 * Tokens.space-xs));
            y: (parent.height - self.height) / 2;
            value: Playback.volume;
            fill-color: root.accent;
            live(v) => {
                Playback.volume = v;
                if (Math.round(v * 100) != root.last-sent) {
                    root.last-sent = Math.round(v * 100);
                    Playback.set-volume(v);
                }
            }
            released(v) => {
                Playback.volume = v;
                Playback.set-volume(v);
            }
        }
    }
}
