// The lyrics page: a port of the yoshik.xyz lyrics overlay (lyrics.css + karaoke.css).
// Full window. Classic view: blurred art, cover + title + artist + progress on the left, lines on
// the right with the active line centred. Karaoke view (dev builds with an Apple Music token only):
// one focus word at a time on a near-black stage.
//
// Rust (src/lyrics_view.rs) does all text measuring, wrapping and timing: every line arrives with
// its rows already wrapped for the current window and with its exact height and offset, so the
// scroll target is known without measuring anything here. Rust also drives `lyric-ms`, the
// active line and the karaoke word slots.
//
// Colours, type and motion come from Tokens. The page's own geometry is ported from the site and
// measured against by Rust, so it stays here as named properties rather than on the shared scale.
import { Tokens } from "tokens.slint";
import { Crossfade } from "cover.slint";
import { Glyph, IconButton } from "base.slint";
import { Playback, PlayButton, LyrLine, KWord, KMotion, Icons } from "now_playing.slint";

// Geometry shared with Rust (lyrics_view::Geometry). Change both together.
export global LyrGeo {
    out property <length> side-max: 540px;
    out property <length> size-min: 22px;
    out property <length> size-max: 34px;
    out property <length> active-min: 30px;
    out property <length> active-max: 48px;
    // Padding above and below every line (included in the heights Rust sends).
    out property <length> line-pad: 16px;
    out property <float> line-height: 1.35;
    out property <float> tracking: -0.015;
    public pure function pad-x(w: length) -> length { return w * 0.06; }
    public pure function side-w(w: length) -> length { return min(w * 0.38, LyrGeo.side-max); }
    public pure function size(w: length) -> length { return clamp(w * 0.029, LyrGeo.size-min, LyrGeo.size-max); }
    public pure function active-size(w: length) -> length { return clamp(w * 0.04, LyrGeo.active-min, LyrGeo.active-max); }
}

// Sizes shared by the page's controls.
global LyrChrome {
    // .karaoke-toggle and the close button: 38px glass pills.
    out property <length> pill: 38px;
    out property <length> pill-pad: Tokens.space-lg;
    out property <length> pill-icon: 14px;
    // The white play / pause disc and the row it sits in.
    out property <length> disc: 56px;
    out property <length> transport-gap: 14px;
    // Distance of the floating chrome from the window edge.
    out property <length> edge: 22px;
}

// .karaoke-toggle: a glass pill. `active` is the white state.
component Pill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: LyrChrome.pill;
    width: root.label == "" ? LyrChrome.pill : row.preferred-width;
    border-radius: Tokens.radius-full;
    border-width: Tokens.hairline;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    border-color: root.active ? Tokens.text-bright : Tokens.border-strong;
    background: root.active ? Tokens.text-bright
        : ta.pressed ? Tokens.bg-pressed
        : ta.has-hover ? Tokens.bg-glass-hover
        : Tokens.bg-glass;
    animate background, border-color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    row := HorizontalLayout {
        padding-left: root.label == "" ? 0px : LyrChrome.pill-pad;
        padding-right: root.label == "" ? 0px : LyrChrome.pill-pad;
        spacing: Tokens.space-xs;
        alignment: center;
        Glyph {
            y: (parent.height - self.height) / 2;
            size: LyrChrome.pill-icon;
            commands: root.icon;
            tint: root.active ? Tokens.black : Tokens.text-bright;
        }
        if root.label != "" : Text {
            text: root.label;
            vertical-alignment: center;
            font-family: Tokens.font-lyrics-ui;
            font-size: Tokens.size-caption;
            font-weight: Tokens.weight-medium;
            color: root.active ? Tokens.black : Tokens.text-bright;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// shuffle · prev · play · next · repeat
component Transport inherits HorizontalLayout {
    spacing: LyrChrome.transport-gap;
    alignment: center;
    IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-lg; icon: Icons.shuffle; active: Playback.shuffle; active-color: Tokens.text-bright; clicked => { Playback.toggle-shuffle(); } }
    IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-lg; icon: Icons.prev; solid: true; tint: Tokens.text-bright; icon-size: Tokens.icon-lg; clicked => { Playback.prev(); } }
    PlayButton { y: (parent.height - self.height) / 2; diameter: LyrChrome.disc; clicked => { Playback.play-pause(); } }
    IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-lg; icon: Icons.next; solid: true; tint: Tokens.text-bright; icon-size: Tokens.icon-lg; clicked => { Playback.next(); } }
    IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-lg; icon: Icons.repeat; active: Playback.repeat > 0; active-color: Tokens.text-bright; clicked => { Playback.toggle-repeat(); } }
}

global Clock {
    public pure function mmss(ms: int) -> string {
        let secs = Math.floor(Math.max(ms, 0) / 1000);
        let sec = Math.mod(secs, 60);
        return "\{Math.floor(secs / 60)}:\{sec < 10 ? "0" : ""}\{sec}";
    }
}

// One lyric line (.lyr-line). Rows come pre-wrapped from Rust; the active line uses the larger
// rows (`arows`), or per-letter rows (`wrows`) when it has word timings. Past lines are dimmed,
// upcoming ones dimmer, the active one white; unlit letters of the active line light as
// `lyric-ms` passes.
component LyricLineView inherits Rectangle {
    in property <LyrLine> line;
    in property <int> state; // -1 past, 0 active, 1 upcoming, 2 unsynced
    in property <length> size;
    in property <length> active-size;
    // Where the line's centre sits in the column (0 = top edge) and the column height: lines fade
    // out over the top 10% and bottom 8%, like the site's mask-image (per line, no overlay bands).
    in property <length> centre-y;
    in property <length> view-h;
    callback clicked;
    opacity: max(0, min(1, min(root.centre-y / (root.view-h * 0.10), (root.view-h - root.centre-y) / (root.view-h * 0.08))));
    property <bool> on: root.state == 0;
    property <length> fs: root.on ? root.active-size : root.size;
    property <length> lh: root.fs * LyrGeo.line-height;
    property <color> tone: root.on ? Tokens.text-bright : root.state == 1 ? Tokens.text-faint : Tokens.text-tertiary;
    height: root.on ? root.line.ah : root.line.h;

    if !root.on || root.line.wrows.length == 0 : Rectangle {
        for row[k] in (root.on ? root.line.arows : root.line.rows) : Text {
            x: 0;
            y: LyrGeo.line-pad + k * root.lh;
            height: root.lh;
            text: row;
            vertical-alignment: center;
            font-family: Tokens.font-lyrics;
            font-weight: Tokens.weight-bold;
            font-size: root.fs;
            letter-spacing: LyrGeo.tracking * root.fs;
            color: root.tone;
            animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
        }
    }
    if root.on && root.line.wrows.length > 0 : Rectangle {
        for wrow[k] in root.line.wrows : HorizontalLayout {
            x: 0;
            y: LyrGeo.line-pad + k * root.lh;
            height: root.lh;
            spacing: 0;
            alignment: start;
            for word in wrow.words : HorizontalLayout {
                spacing: LyrGeo.tracking * root.fs;
                for letter in word.letters : Text {
                    text: letter.ch;
                    vertical-alignment: center;
                    font-family: Tokens.font-lyrics;
                    font-weight: Tokens.weight-bold;
                    font-size: root.fs;
                    // Lights instantly: a fade per letter would keep the renderer drawing at the
                    // display rate for the whole line. Frames happen only when a letter is due.
                    color: Playback.lyric-ms >= letter.at ? Tokens.text-bright : Tokens.text-faint;
                }
                if word.space : Text {
                    text: " ";
                    font-family: Tokens.font-lyrics;
                    font-weight: Tokens.weight-bold;
                    font-size: root.fs;
                }
            }
        }
    }
    TouchArea {
        enabled: root.state != 2;
        mouse-cursor: root.state != 2 ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// .lyrics-lines: the column scrolls so the active line sits at the vertical centre (padding of
// half the height above the first line and below the last). Smooth scroll on line change; a wheel
// scroll pauses following for a few seconds (lyrUserScrollAt in script.js).
component LyricsColumn inherits Rectangle {
    in property <length> size;
    in property <length> active-size;
    property <int> active: Playback.lyr-active;
    property <length> content-h: Playback.lyr-total-h + root.height;
    // The scroll target for the active line (0 = first line at the centre).
    property <length> follow: root.active >= 0 && root.active < Playback.lyr-lines.length
        ? -(Playback.lyr-lines[root.active].top + Playback.lyr-lines[root.active].ah / 2)
        : 0px;
    property <length> offset;
    property <bool> paused;
    property <duration> resume-at;
    // After a wheel scroll, following resumes this long after the last scroll. The timer that
    // checks runs only while paused.
    property <duration> resume-after: 3s;
    property <duration> resume-poll: 250ms;
    clip: true;

    changed follow => {
        if (!root.paused) {
            root.offset = root.follow;
        }
    }
    init => { root.offset = root.follow; }

    Timer {
        interval: root.resume-poll;
        running: root.paused;
        triggered => {
            if (animation-tick() >= root.resume-at) {
                root.paused = false;
                root.offset = root.follow;
            }
        }
    }

    TouchArea {
        scroll-event(e) => {
            root.paused = true;
            root.resume-at = animation-tick() + root.resume-after;
            root.offset = clamp(root.offset + e.delta-y, -Playback.lyr-total-h, 0px);
            return accept;
        }
    }

    content := Rectangle {
        x: 0;
        y: root.height / 2 + root.offset;
        width: parent.width;
        height: Playback.lyr-total-h;
        animate y { duration: Tokens.duration-slow; easing: Tokens.ease-in-out; }
        VerticalLayout {
            alignment: start;
            spacing: 0;
            for line[i] in Playback.lyr-lines : LyricLineView {
                line: line;
                centre-y: content.y + self.y + self.height / 2;
                view-h: root.height;
                size: root.size;
                active-size: root.active-size;
                state: !Playback.lyr-synced ? 2 : i < root.active ? -1 : i == root.active ? 0 : 1;
                clicked => {
                    root.paused = false;
                    Playback.seek(line.start-ms);
                }
            }
        }
    }
}

// One karaoke word (.vk-w): highlight box, word texture, optional glyph, laid out at the base em
// (padding .1em .28em .14em, line-height 1) and scaled / tilted on the GPU around 50% 55%.
component KaraokeWord inherits Rectangle {
    in property <KWord> w;
    in property <KMotion> m;
    property <length> em: root.w.base;
    property <length> grid: 24px;
    visible: root.m.opacity > 0.004;
    z: root.m.z;
    width: root.w.tw + 0.56 * root.em;
    height: 1.24 * root.em;
    x: root.m.x - self.width / 2;
    y: root.m.y - self.height / 2;
    transform-origin: { x: self.width / 2, y: self.height * 0.55 };
    transform-scale: root.m.scale;
    transform-rotation: root.m.rot * 1deg;

    // .vk-hl: inset .03em .05em .05em, radius .22em, slides in and scales around 28% 60%, tilted.
    if root.m.hl > 0.003 : Rectangle {
        x: 0.05 * root.em + root.m.hl-dx * root.em;
        y: 0.03 * root.em;
        width: parent.width - 0.1 * root.em;
        height: parent.height - 0.08 * root.em;
        border-radius: 0.22 * root.em;
        background: Playback.k-highlight.with-alpha(root.m.hl);
        transform-origin: { x: self.width * 0.28, y: self.height * 0.6 };
        transform-scale-x: root.m.hl-sx;
        transform-scale-y: root.m.hl-sy;
        transform-rotation: root.w.tilt * 1deg;
    }
    Image {
        x: root.w.ix;
        y: root.w.iy;
        width: root.w.iw;
        height: root.w.ih;
        source: root.w.img;
        // Static per state, so the recoloured texture stays cached; fades go through opacity.
        colorize: root.w.color;
        opacity: root.m.opacity;
        image-fit: fill;
        image-rendering: smooth;
    }
    if root.w.icon != "" && root.m.hl > 0.003 : Path {
        x: root.w.icon-left ? 0.1 * root.em - 0.82 * root.em : parent.width - 0.1 * root.em;
        y: parent.height / 2 - 0.41 * root.em;
        width: 0.82 * root.em;
        height: 0.82 * root.em;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.w.icon;
        fill: transparent;
        stroke: Playback.k-highlight;
        opacity: root.m.hl;
        stroke-width: 2.3 * 0.82 * root.em / root.grid * Tokens.hairline;
        stroke-line-cap: round;
        stroke-line-join: round;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.m.icon-scale;
        transform-rotation: root.m.icon-rot * 1deg;
    }
}

component SegButton inherits Rectangle {
    in property <string> label;
    in property <bool> pressed;
    callback clicked;
    property <length> seg-height: 30px;
    width: txt.preferred-width + 2 * Tokens.space-md;
    height: root.seg-height;
    border-radius: Tokens.radius-md;
    background: root.pressed ? Tokens.text-bright : ta.pressed ? Tokens.bg-pressed : ta.has-hover ? Tokens.bg-hover : transparent;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    txt := Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-family: Tokens.font-mono;
        font-weight: Tokens.weight-medium;
        font-size: Tokens.size-caption;
        letter-spacing: Tokens.tracking-caption;
        color: root.pressed ? Tokens.text-inverse : ta.has-hover ? Tokens.text-bright : Tokens.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A colour swatch: click cycles through a palette (Rust), right-click goes back.
component Swatch inherits HorizontalLayout {
    in property <string> name;
    in property <color> value;
    property <length> dot: 22px;
    property <length> ring: 2px;
    spacing: Tokens.space-sm;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.dot;
        height: root.dot;
        border-radius: Tokens.radius-full;
        border-width: root.ring;
        border-color: ta.has-hover ? Tokens.text-secondary : Tokens.text-faint;
        background: root.value;
        animate border-color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
        ta := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up) {
                    Playback.cycle-color(root.name, e.button == PointerEventButton.right ? -1 : 1);
                }
            }
        }
    }
    Text {
        text: root.name;
        vertical-alignment: center;
        font-family: Tokens.font-mono;
        font-weight: Tokens.weight-medium;
        font-size: Tokens.size-caption;
        color: Tokens.text-secondary;
    }
}

// .vk-settings: style segment + palette + reset.
component KaraokeSettings inherits Rectangle {
    property <length> bar-height: 46px;
    property <length> bar-gap: 14px;
    height: root.bar-height;
    width: bar.preferred-width;
    border-radius: Tokens.radius-lg;
    border-width: Tokens.hairline;
    border-color: Tokens.border-strong;
    background: Tokens.bg-overlay;
    bar := HorizontalLayout {
        padding: Tokens.space-sm;
        spacing: root.bar-gap;
        Rectangle {
            width: seg.preferred-width;
            border-radius: Tokens.radius-md;
            background: Tokens.bg-hover;
            seg := HorizontalLayout {
                padding: 0px;
                spacing: Tokens.space-2xs;
                SegButton { label: "Ship"; pressed: Playback.k-style == "ship"; clicked => { Playback.set-k-style("ship"); } }
                SegButton { label: "Fisheye"; pressed: Playback.k-style == "fisheye"; clicked => { Playback.set-k-style("fisheye"); } }
                SegButton { label: "Fisheye Visual"; pressed: Playback.k-style == "fisheye-visual"; clicked => { Playback.set-k-style("fisheye-visual"); } }
                SegButton { label: "Visual"; pressed: Playback.k-style == "visual"; clicked => { Playback.set-k-style("visual"); } }
            }
        }
        Swatch { name: "lyric"; value: Playback.k-lyric; }
        Swatch { name: "highlight"; value: Playback.k-highlight; }
        Swatch { name: "secondary"; value: Playback.k-secondary; }
        Rectangle {
            width: reset.preferred-width + 2 * Tokens.space-sm;
            reset := Text {
                text: "reset";
                vertical-alignment: center;
                horizontal-alignment: center;
                font-family: Tokens.font-mono;
                font-weight: Tokens.weight-medium;
                font-size: Tokens.size-caption;
                color: reset-ta.has-hover ? Tokens.text-bright : Tokens.text-secondary;
                animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
            }
            reset-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Playback.reset-k-colors(); }
            }
        }
    }
}

// A small glass button for the per-song timing offset.
component OffsetButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    property <length> button-width: 52px;
    property <length> button-height: 28px;
    width: root.button-width;
    height: root.button-height;
    border-radius: Tokens.radius-full;
    background: ta.pressed ? Tokens.bg-pressed : ta.has-hover ? Tokens.bg-glass-hover : Tokens.bg-glass;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    Text {
        text: root.label;
        color: Tokens.text-primary;
        font-size: Tokens.size-caption;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LyricsOverlay inherits Rectangle {
    property <bool> karaoke: Playback.karaoke;
    property <length> pad: LyrGeo.pad-x(root.width);
    property <length> side: LyrGeo.side-w(root.width);
    property <length> col-x: root.pad + root.side + root.pad;
    // .lyrics-side block: art, gap, title, gap, artist, gap, progress bar, then times and transport.
    property <length> title-gap: 18px;
    property <length> title-h: 22px;
    property <length> artist-gap: 5px;
    property <length> artist-h: 18px;
    property <length> prog-gap: 20px;
    property <length> prog-h: 5px;
    property <length> times-gap: 8px;
    property <length> times-h: 16px;
    property <length> transport-gap: 10px;
    property <length> prog-y: root.side + root.title-gap + root.title-h + root.artist-gap + root.artist-h + root.prog-gap;
    property <length> side-h: root.prog-y + root.prog-h + root.times-gap + root.times-h + root.transport-gap + LyrChrome.disc;
    property <length> side-top: (root.height - root.side-h) / 2;
    // The blurred background is drawn larger than the window so its soft edge stays outside.
    property <length> bleed: 40px;
    // Art shadow on the classic view.
    property <length> art-shadow-blur: 70px;
    property <length> art-shadow-offset: Tokens.space-xl;
    // Lyrics column inset from the window top and bottom.
    property <length> column-inset: Tokens.space-xl;
    // Timing offset row.
    property <length> offset-h: 28px;
    property <length> offset-label: 72px;
    // Karaoke: small art + title bottom left, thin progress bar along the bottom.
    property <length> meta-art: 44px;
    property <float> meta-share: 0.34;
    property <length> stage-prog: 3px;
    property <length> hint-h: 18px;
    // Karaoke chrome hides after `idle-after` without pointer movement. The timer that checks runs
    // only on the karaoke stage while the chrome is showing.
    property <bool> idle;
    property <duration> moved-at;
    property <duration> idle-after: 3s;
    property <duration> idle-poll: 500ms;
    changed karaoke => { root.idle = false; root.moved-at = animation-tick(); }

    opacity: Playback.expanded ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: Tokens.duration-slow; easing: Tokens.ease-out; }
    background: root.karaoke ? Tokens.bg-stage : Tokens.bg-base;

    // Swallow clicks so nothing behind the overlay reacts; track the pointer for the idle fade.
    TouchArea {
        mouse-cursor: (root.karaoke && root.idle) ? MouseCursor.none : MouseCursor.default;
        changed mouse-x => { root.idle = false; root.moved-at = animation-tick(); }
        changed mouse-y => { root.idle = false; root.moved-at = animation-tick(); }
    }
    Timer {
        interval: root.idle-poll;
        running: root.karaoke && !root.idle && Playback.expanded;
        triggered => {
            if (animation-tick() - root.moved-at >= root.idle-after) {
                root.idle = true;
            }
        }
    }

    // ---- classic view --------------------------------------------------------------------
    if !root.karaoke : Rectangle {
        // .lyrics-bg + .lyrics-vignette: one pre-rendered image (see art::blurred_bg). Rust pre-blurs
        // and darkens a tiny copy; the scaler smooths it.
        Crossfade {
            x: -root.bleed;
            y: -root.bleed;
            width: parent.width + 2 * root.bleed;
            height: parent.height + 2 * root.bleed;
            source: Playback.bg-art;
        }

        // .lyrics-side
        Rectangle {
            x: root.pad;
            y: root.side-top;
            width: root.side;
            height: root.side-h;
            Rectangle {
                x: 0;
                y: 0;
                width: root.side;
                height: root.side;
                border-radius: Tokens.radius-lg;
                drop-shadow-offset-y: root.art-shadow-offset;
                drop-shadow-blur: root.art-shadow-blur;
                drop-shadow-color: Tokens.shadow;
                background: Playback.side-art.width > 0 ? transparent : Tokens.art-placeholder;
                Crossfade {
                    width: parent.width;
                    height: parent.height;
                    source: Playback.side-art;
                    fade: Playback.art-fresh;
                }
            }
            Text {
                x: 0;
                y: root.side + root.title-gap;
                width: root.side;
                height: root.title-h;
                text: Playback.title;
                overflow: elide;
                vertical-alignment: center;
                font-family: Tokens.font-lyrics-ui;
                font-weight: Tokens.weight-semibold;
                font-size: Tokens.size-heading;
                color: Tokens.text-bright;
            }
            Text {
                x: 0;
                y: root.side + root.title-gap + root.title-h + root.artist-gap;
                width: root.side;
                height: root.artist-h;
                text: Playback.artist;
                overflow: elide;
                vertical-alignment: center;
                font-size: Tokens.size-body;
                color: Tokens.text-secondary;
            }
            Rectangle {
                x: 0;
                y: root.prog-y;
                width: root.side;
                height: root.prog-h;
                border-radius: Tokens.radius-full;
                background: Tokens.bg-track;
                Rectangle {
                    x: 0;
                    width: Playback.duration-ms > 0 ? parent.width * clamp(Playback.position-ms / Playback.duration-ms, 0, 1) : 0px;
                    border-radius: Tokens.radius-full;
                    background: Tokens.text-primary;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (Playback.duration-ms > 0) {
                            Playback.seek(Math.round(clamp(self.mouse-x / parent.width, 0, 1) * Playback.duration-ms));
                        }
                    }
                }
            }
        }

        // Times and transport under the progress bar.
        Rectangle {
            x: root.pad;
            y: root.side-top + root.prog-y + root.prog-h + root.times-gap;
            width: root.side;
            height: root.times-h;
            Text {
                x: 0;
                text: Clock.mmss(Playback.position-ms);
                font-size: Tokens.size-caption;
                color: Tokens.text-tertiary;
            }
            Text {
                x: parent.width - self.width;
                text: Clock.mmss(Playback.duration-ms);
                font-size: Tokens.size-caption;
                color: Tokens.text-tertiary;
            }
        }
        Transport {
            x: root.pad;
            y: root.side-top + root.side-h - LyrChrome.disc;
            width: root.side;
            height: LyrChrome.disc;
        }
        // Per-song lyrics timing offset.
        if Playback.lyr-synced && !Playback.karaoke : HorizontalLayout {
            x: root.pad;
            y: root.side-top + root.side-h + Tokens.space-sm;
            width: root.side;
            height: root.offset-h;
            alignment: center;
            spacing: Tokens.space-sm;
            OffsetButton { label: "−0.1s"; clicked => { Playback.lyrics-offset(-100); } }
            Text {
                width: root.offset-label;
                text: Playback.lyr-offset == 0 ? "lyrics in sync" : (Playback.lyr-offset > 0 ? "+" : "") + Playback.lyr-offset / 1000 + "s";
                color: Tokens.text-tertiary;
                font-size: Tokens.size-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            OffsetButton { label: "+0.1s"; clicked => { Playback.lyrics-offset(100); } }
        }

        // .lyrics-lines
        LyricsColumn {
            x: root.col-x;
            y: root.column-inset;
            width: max(0px, root.width - root.col-x - root.pad);
            height: parent.height - 2 * root.column-inset;
            size: LyrGeo.size(root.width);
            active-size: LyrGeo.active-size(root.width);
        }
    }

    // ---- karaoke view --------------------------------------------------------------------
    if root.karaoke : Rectangle {
        // .vk-glow + vignette: one pre-rendered image (see art::karaoke_bg).
        Image {
            width: parent.width;
            height: parent.height;
            source: Playback.k-bg;
            image-fit: fill;
            image-rendering: smooth;
        }
        for w[i] in Playback.k-words : KaraokeWord { w: w; m: Playback.k-motion[i]; }

        // .vk-meta
        Rectangle {
            x: LyrChrome.edge;
            y: parent.height - LyrChrome.edge - root.meta-art;
            width: min(parent.width * root.meta-share, root.meta-art + Tokens.space-md + max(mt.preferred-width, ma.preferred-width));
            height: root.meta-art;
            opacity: root.idle ? 0 : 1;
            animate opacity { duration: Tokens.duration-slow; easing: Tokens.ease-out; }
            Image {
                x: 0;
                width: root.meta-art;
                height: root.meta-art;
                source: Playback.thumb-art;
                image-fit: cover;
                image-rendering: smooth;
            }
            mt := Text {
                x: root.meta-art + Tokens.space-md;
                y: Tokens.space-xs;
                width: parent.width - self.x;
                text: Playback.title;
                overflow: elide;
                font-family: Tokens.font-lyrics-ui;
                font-weight: Tokens.weight-semibold;
                font-size: Tokens.size-body;
                color: Tokens.text-bright;
            }
            ma := Text {
                x: root.meta-art + Tokens.space-md;
                y: Tokens.space-xl;
                width: parent.width - self.x;
                text: Playback.artist;
                overflow: elide;
                font-size: Tokens.size-caption;
                color: Tokens.text-tertiary;
            }
        }
        // .vk-prog
        Rectangle {
            y: parent.height - root.stage-prog;
            height: root.stage-prog;
            background: Tokens.bg-hover;
            Rectangle {
                x: 0;
                width: Playback.duration-ms > 0 ? parent.width * clamp(Playback.position-ms / Playback.duration-ms, 0, 1) : 0px;
                background: Playback.k-highlight;
            }
        }
        KaraokeSettings {
            x: (parent.width - self.width) / 2;
            y: parent.height - LyrChrome.edge - self.height;
            opacity: root.idle ? 0 : 1;
            animate opacity { duration: Tokens.duration-slow; easing: Tokens.ease-out; }
        }
    }

    // ---- controls (.lyrics-controls) -----------------------------------------------------
    HorizontalLayout {
        x: root.width - LyrChrome.edge - self.width;
        y: LyrChrome.edge;
        width: self.preferred-width;
        height: LyrChrome.pill;
        spacing: Tokens.space-md;
        opacity: (root.karaoke && root.idle) ? 0 : 1;
        animate opacity { duration: Tokens.duration-slow; easing: Tokens.ease-out; }
        // Karaoke hides the side column, so its transport sits up here.
        if root.karaoke : Rectangle {
            width: kt.preferred-width + 2 * Tokens.space-xs;
            border-radius: Tokens.radius-full;
            border-width: Tokens.hairline;
            border-color: Tokens.border-strong;
            background: Tokens.bg-glass;
            kt := HorizontalLayout {
                x: Tokens.space-xs;
                spacing: Tokens.space-2xs;
                alignment: center;
                IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-sm; icon: Icons.prev; solid: true; tint: Tokens.text-bright; icon-size: Tokens.icon-sm; clicked => { Playback.prev(); } }
                IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-sm; icon: Playback.playing ? Icons.pause : Icons.play; solid: true; tint: Tokens.text-bright; icon-size: Tokens.icon-sm; clicked => { Playback.play-pause(); } }
                IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-sm; icon: Icons.next; solid: true; tint: Tokens.text-bright; icon-size: Tokens.icon-sm; clicked => { Playback.next(); } }
            }
        }
        if Playback.karaoke-allowed : Pill {
            label: "Karaoke";
            icon: Icons.mic;
            active: Playback.karaoke;
            enabled: Playback.karaoke-available;
            clicked => { Playback.set-karaoke(!Playback.karaoke); }
        }
        Pill {
            icon: Icons.close;
            clicked => { Playback.expanded = false; }
        }
    }

    // .lyrics-hint
    if Playback.lyr-hint != "" : Text {
        x: Tokens.space-xl;
        y: parent.height - Tokens.space-xl - root.hint-h;
        width: parent.width - 2 * Tokens.space-xl;
        height: root.hint-h;
        text: Playback.lyr-hint;
        horizontal-alignment: center;
        font-size: Tokens.size-caption;
        color: Tokens.text-faint;
    }
}
