// Shared building blocks for the browse pages, built on base.slint.
import { Tokens } from "tokens.slint";
import { Cover } from "cover.slint";
import { Icons } from "now_playing.slint";
import { Label, Caption, Glyph, ListRow, Button, IconButton, SectionHeader } from "base.slint";
import { Song, TrackRow, Badge, Explicit, SongColumns, SongCols } from "track_row.slint";

export { Label, Caption, Glyph, ListRow, Button, IconButton, SectionHeader, Song, TrackRow, Explicit }

export struct Card {
    title: string,
    subtitle: string,
    uri: string,
    art: image,
    liked: bool,
    round: bool,
    pinned: bool,
    // Cadence-local item (local folder / local file), labelled as such.
    local: bool,
    // The art was downloaded just now, so it fades in. Cached art (false) appears at once.
    fresh: bool,
}


export struct ShelfData {
    key: string,
    title: string,
    round: bool,
    cards: [Card],
    // Non-empty: a "Show all" link opening this route.
    more: string,
    note: string,
    hidden: bool,
}

// Fades and slides a page in when it is created.
export component PageFade inherits Rectangle {
    property <bool> shown: false;
    width: 100%;
    height: 100%;
    opacity: root.shown ? 1 : 0;
    y: root.shown ? 0px : Tokens.slide;
    animate opacity { duration: Tokens.duration-base; easing: Tokens.ease-out; }
    animate y { duration: Tokens.duration-base; easing: Tokens.ease-out; }
    init => {
        if (root.opacity < 1 && root.y >= 0px) {
            root.shown = true;
        }
    }
    @children
}

export component ArtTile inherits Rectangle {
    in property <image> source;
    in property <length> radius;
    in property <color> backdrop: Tokens.bg-base;
    in property <bool> liked;
    in property <bool> local;
    in property <bool> hovered;
    in property <bool> pressed;
    in property <bool> fade: true;
    // Tiles that show a glyph instead of art (Liked Songs, local folders) are not "loading".
    property <bool> glyph-tile: root.liked || root.local;
    property <float> glyph-scale: 0.38;
    Cover {
        width: parent.width;
        height: parent.height;
        source: root.source;
        radius: root.radius;
        backdrop: root.backdrop;
        fade: root.fade;
        placeholder: root.glyph-tile ? Tokens.bg-elevated : Tokens.art-placeholder;
    }
    if root.liked || (root.local && root.source.width == 0) : Glyph {
        size: parent.width * root.glyph-scale;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        solid: root.liked;
        tint: root.liked ? Tokens.accent : Tokens.text-tertiary;
        commands: root.liked ? Icons.heart : Icons.folder;
    }
    ListRow {
        border-radius: root.radius;
        hovered: root.hovered;
        pressed: root.pressed;
    }
}

// Circular play button shown over a card on hover.
export component HoverPlay inherits Rectangle {
    in property <bool> shown;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    // The play triangle looks centred when nudged right a little.
    property <length> optical-nudge: 1px;
    width: Tokens.control-lg;
    height: Tokens.control-lg;
    border-radius: Tokens.radius-full;
    background: ta.pressed ? Tokens.bg-inverse-pressed : ta.has-hover ? Tokens.bg-inverse-hover : Tokens.bg-inverse;
    opacity: root.shown ? 1 : 0;
    drop-shadow-blur: Tokens.space-md;
    drop-shadow-color: Tokens.shadow;
    animate opacity { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    Glyph {
        x: (parent.width - self.width) / 2 + root.optical-nudge;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-md;
        solid: true;
        tint: Tokens.text-inverse;
        commands: Icons.play;
    }
    ta := TouchArea {
        enabled: root.shown;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component CardView inherits Rectangle {
    in property <Card> card;
    in property <length> art-size: Tokens.art-card;
    in property <bool> playable: true;
    callback clicked();
    callback play();
    callback menu(length, length);
    // Title and subtitle under the art.
    out property <length> text-height: 44px;
    width: root.art-size;
    height: root.art-size + root.text-height;
    VerticalLayout {
        spacing: 0;
        ArtTile {
            width: root.art-size;
            height: root.art-size;
            radius: root.card.round ? root.art-size / 2 : Tokens.radius-lg;
            source: root.card.art;
            fade: root.card.fresh;
            liked: root.card.liked;
            local: root.card.local;
            hovered: ta.has-hover;
            pressed: ta.pressed;
        }
        Rectangle { height: Tokens.space-xs; }
        Label {
            text: root.card.title;
            font-weight: Tokens.weight-medium;
            horizontal-alignment: root.card.round ? center : left;
        }
        Caption {
            text: root.card.local ? "Local · " + root.card.subtitle : root.card.subtitle;
            horizontal-alignment: root.card.round ? center : left;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if root.playable : HoverPlay {
        x: root.art-size - self.width - Tokens.space-sm;
        y: root.art-size - self.height - Tokens.space-sm;
        shown: ta.has-hover || self.hovered;
        clicked => { root.play(); }
    }
}

// Placeholder card while a shelf loads.
export component SkeletonCard inherits Rectangle {
    in property <length> art-size: Tokens.art-card;
    in property <bool> round;
    property <length> text-height: 44px;
    property <length> line-1: 12px;
    property <length> line-2: 10px;
    width: root.art-size;
    height: root.art-size + root.text-height;
    Rectangle {
        y: 0;
        height: root.art-size;
        border-radius: root.round ? root.art-size / 2 : Tokens.radius-lg;
        background: Tokens.bg-surface;
    }
    Rectangle { x: 0; y: root.art-size + Tokens.space-sm; width: root.art-size * 0.8; height: root.line-1; border-radius: Tokens.radius-sm; background: Tokens.bg-surface; }
    Rectangle { x: 0; y: root.art-size + Tokens.space-xl; width: root.art-size * 0.5; height: root.line-2; border-radius: Tokens.radius-sm; background: Tokens.bg-surface; }
}

// Horizontal shelf of cards; sideways wheel / trackpad and drag scroll it.
export component Shelf inherits Rectangle {
    in property <[Card]> model;
    in property <length> art-size: Tokens.art-card;
    in property <length> lead: Tokens.page-margin;
    in property <bool> skeleton;
    callback picked(string);
    callback play(string);
    callback menu(string, length, length);
    property <length> text-height: 44px;
    property <int> skeleton-count: 6;
    height: root.art-size + root.text-height;
    TouchArea {
        scroll-event(e) => {
            if (abs(e.delta-y) > abs(e.delta-x)) {
                return reject;
            }
            flick.content-x = max(flick.width - flick.content-width, min(0px, flick.content-x + e.delta-x));
            return accept;
        }
    }
    flick := Flickable {
        content-width: root.lead * 2 + Math.max(root.model.length, root.skeleton ? root.skeleton-count : 0) * (root.art-size + Tokens.space-lg) - Tokens.space-lg;
        content-height: root.height;
        if root.skeleton && root.model.length == 0 : HorizontalLayout {
            x: root.lead;
            spacing: Tokens.space-lg;
            for i in root.skeleton-count : SkeletonCard { art-size: root.art-size; }
        }
        for c[i] in root.model : CardView {
            x: root.lead + i * (root.art-size + Tokens.space-lg);
            card: c;
            art-size: root.art-size;
            clicked => { root.picked(c.uri); }
            play => { root.play(c.uri); }
            menu(x, y) => { root.menu(c.uri, x, y); }
        }
    }
}

// Column geometry of the search page's rows (Part 3 moves search to TrackRow).
global TrackColumns {
    out property <length> pad: Tokens.space-lg;
    out property <length> gap: Tokens.space-lg;
    out property <length> index-width: 28px;
    out property <length> duration-width: 52px;
    out property <length> heart-width: Tokens.control-sm;
    out property <length> action-width: 72px;
    out property <length> added-width: 112px;
    // Below these widths the date column, then the album column, are dropped.
    out property <length> wide-from: 860px;
    out property <length> album-from: 640px;
    out property <float> title-share: 0.6;
}

// The search page's song row (search moves to TrackRow in Part 3; everything else uses it now).
export component TrackItem inherits Rectangle {
    in property <Song> item;
    in property <int> number;
    in property <bool> show-album: true;
    in property <bool> show-added;
    in property <bool> show-heart: true;
    in property <bool> selected;
    in property <bool> playing;
    in property <string> action-label;
    callback clicked();
    callback double-clicked();
    callback menu(length, length);
    callback heart();
    callback action();
    height: Tokens.row-md;

    property <bool> wide: root.width >= TrackColumns.wide-from;
    property <length> pad: TrackColumns.pad;
    property <length> idx-w: TrackColumns.index-width;
    property <length> dur-w: TrackColumns.duration-width;
    property <length> heart-w: root.show-heart ? TrackColumns.heart-width : 0px;
    property <length> act-w: root.action-label != "" ? TrackColumns.action-width : 0px;
    property <length> added-w: root.show-added && root.wide ? TrackColumns.added-width : 0px;
    property <bool> album-on: root.show-album && root.width >= TrackColumns.album-from;
    property <length> gap: TrackColumns.gap;
    property <length> inner-w: root.width - 2 * Tokens.space-lg;
    property <length> avail: inner-w - 2 * pad - idx-w - dur-w - heart-w - act-w - added-w - 4 * gap;
    property <length> title-w: root.album-on ? avail * TrackColumns.title-share : avail;
    property <length> album-w: avail * (1 - TrackColumns.title-share) - gap;
    property <length> title-x: Tokens.space-lg + pad + idx-w + gap;
    property <length> album-x: title-x + title-w + gap;
    property <length> added-x: album-x + (root.album-on ? album-w + gap : 0px);
    // The "now playing" mark: three bars in an icon-xs box.
    property <length> mark: Tokens.icon-xs;
    property <length> mark-bar: 2px;
    // Episode progress bar.
    property <length> progress-width: 120px;
    property <length> heart-button: 28px;
    property <length> action-height: 30px;
    property <float> unavailable-opacity: 0.45;
    opacity: root.item.unavailable ? root.unavailable-opacity : 1;

    ListRow {
        x: Tokens.space-lg;
        width: root.inner-w;
        hovered: ta.has-hover;
        pressed: ta.pressed;
        selected: root.selected;
    }
    if !root.playing : Label {
        x: Tokens.space-lg + root.pad;
        width: root.idx-w;
        y: (parent.height - self.height) / 2;
        text: root.number > 0 ? "\{root.number}" : "";
        color: Tokens.text-tertiary;
    }
    if root.playing : Rectangle {
        x: Tokens.space-lg + root.pad;
        y: (parent.height - root.mark) / 2;
        width: root.mark;
        height: root.mark;
        Rectangle { x: 0px; y: root.mark / 3; width: root.mark-bar; height: root.mark * 2 / 3; background: Tokens.accent; border-radius: Tokens.radius-full; }
        Rectangle { x: (root.mark - root.mark-bar) / 2; y: 0px; width: root.mark-bar; height: root.mark; background: Tokens.accent; border-radius: Tokens.radius-full; }
        Rectangle { x: root.mark - root.mark-bar; y: root.mark / 2; width: root.mark-bar; height: root.mark / 2; background: Tokens.accent; border-radius: Tokens.radius-full; }
    }
    VerticalLayout {
        x: root.title-x;
        width: root.title-w;
        alignment: center;
        spacing: Tokens.space-2xs;
        Label {
            text: root.item.title;
            font-weight: Tokens.weight-medium;
            color: root.playing ? Tokens.accent : Tokens.text-primary;
        }
        HorizontalLayout {
            spacing: Tokens.space-xs;
            if root.item.explicit : Explicit { y: Tokens.hairline; }
            if root.item.local : Badge { text: "LOCAL"; }
            Caption {
                text: root.item.note != "" ? root.item.note : root.item.artist;
                horizontal-stretch: 1;
            }
        }
        if root.item.progress > 0 : Rectangle {
            height: Tokens.track-height;
            width: root.progress-width;
            border-radius: Tokens.radius-full;
            background: Tokens.bg-track;
            Rectangle { x: 0; width: parent.width * Math.min(1, root.item.progress); border-radius: Tokens.radius-full; background: Tokens.accent; }
        }
    }
    if root.album-on : Caption {
        x: root.album-x;
        width: root.album-w;
        y: (parent.height - self.height) / 2;
        font-size: Tokens.size-body;
        text: root.item.album;
        color: Tokens.text-secondary;
    }
    if root.added-w > 0 : Caption {
        x: root.added-x;
        width: root.added-w;
        y: (parent.height - self.height) / 2;
        text: root.item.added;
        color: Tokens.text-tertiary;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if root.show-heart && root.item.liked-known : Rectangle {
        x: root.width - Tokens.space-lg - root.pad - root.dur-w - root.act-w - root.heart-w;
        y: (parent.height - self.height) / 2;
        width: root.heart-button;
        height: root.heart-button;
        border-radius: Tokens.radius-full;
        background: heart-ta.pressed ? Tokens.bg-pressed : heart-ta.has-hover ? Tokens.bg-hover : transparent;
        opacity: root.item.liked || ta.has-hover || heart-ta.has-hover ? 1 : 0;
        animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
        Glyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: Tokens.icon-md;
            solid: root.item.liked;
            tint: root.item.liked ? Tokens.accent : Tokens.text-secondary;
            commands: Icons.heart;
        }
        heart-ta := TouchArea { clicked => { root.heart(); } }
    }
    if root.action-label != "" : Rectangle {
        x: root.width - Tokens.space-lg - root.pad - root.dur-w - root.act-w + Tokens.space-xs;
        y: (parent.height - self.height) / 2;
        width: root.act-w - Tokens.space-md;
        height: root.action-height;
        border-radius: Tokens.radius-full;
        border-width: Tokens.hairline;
        border-color: root.item.marked ? Tokens.border : Tokens.text-tertiary;
        background: act-ta.pressed ? Tokens.bg-pressed : act-ta.has-hover ? Tokens.bg-hover : transparent;
        animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
        Label {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Tokens.size-caption;
            font-weight: Tokens.weight-semibold;
            text: root.item.marked ? "Added" : root.action-label;
            color: root.item.marked ? Tokens.text-tertiary : Tokens.text-primary;
        }
        act-ta := TouchArea { clicked => { root.action(); } }
    }
    Label {
        x: root.width - Tokens.space-lg - root.pad - root.dur-w;
        width: root.dur-w;
        y: (parent.height - self.height) / 2;
        text: root.item.duration;
        color: Tokens.text-tertiary;
        horizontal-alignment: right;
    }
}

component HeaderCol inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <string> current;
    in property <bool> desc;
    in property <bool> enabled;
    in property <bool> align-right;
    callback pick(string);
    Caption {
        width: parent.width;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        text: root.label + (root.key != "" && root.current == root.key ? (root.desc ? "  ↓" : "  ↑") : "");
        color: root.current == root.key ? Tokens.text-primary : (t.has-hover && root.enabled ? Tokens.text-secondary : Tokens.text-tertiary);
        animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    }
    t := TouchArea {
        enabled: root.enabled;
        clicked => { root.pick(root.key); }
    }
}

// Column header for the song table; same geometry as TrackRow's table variant. Clicking a
// column sorts by it.
export component TableHeader inherits Rectangle {
    in property <bool> show-album: true;
    in property <bool> show-added;
    in property <bool> show-heart: true;
    in property <string> sort-key;
    in property <bool> sort-desc;
    in property <bool> sortable: true;
    callback sort(string);
    property <SongCols> c: SongColumns.table(root.width, true, root.show-album, root.show-added, root.show-heart, false, 0px);
    height: Tokens.row-sm;
    Rectangle {
        y: parent.height - Tokens.hairline;
        height: Tokens.hairline;
        x: SongColumns.inset;
        width: root.width - 2 * SongColumns.inset;
        background: Tokens.border;
    }
    HeaderCol { x: root.c.index-x; width: SongColumns.index-width; label: "#"; key: ""; current: root.sort-key; desc: root.sort-desc; enabled: root.sortable; pick(k) => { root.sort(k); } }
    HeaderCol { x: root.c.title-x; width: root.c.title-w; label: "Title"; key: "title"; current: root.sort-key; desc: root.sort-desc; enabled: root.sortable; pick(k) => { root.sort(k); } }
    if root.c.album-on : HeaderCol { x: root.c.album-x; width: root.c.album-w; label: "Album"; key: "album"; current: root.sort-key; desc: root.sort-desc; enabled: root.sortable; pick(k) => { root.sort(k); } }
    if root.c.added-w > 0 : HeaderCol { x: root.c.added-x; width: root.c.added-w; label: "Date added"; key: "added"; current: root.sort-key; desc: root.sort-desc; enabled: root.sortable; pick(k) => { root.sort(k); } }
    HeaderCol { x: root.c.duration-x; width: SongColumns.duration-width; label: "Time"; key: "duration"; current: root.sort-key; desc: root.sort-desc; enabled: root.sortable; align-right: true; pick(k) => { root.sort(k); } }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    property <length> pad: 14px;
    width: t.preferred-width + 2 * root.pad;
    height: Tokens.control-sm;
    border-radius: Tokens.radius-full;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    background: root.selected ? (ta.has-hover ? Tokens.bg-inverse-hover : Tokens.bg-inverse)
        : ta.pressed ? Tokens.bg-pressed
        : ta.has-hover ? Tokens.bg-elevated
        : Tokens.bg-surface;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    t := Label {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: Tokens.size-caption;
        font-weight: Tokens.weight-semibold;
        color: root.selected ? Tokens.text-inverse : Tokens.text-primary;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <length> font-size: Tokens.size-body;
    in property <bool> auto-focus;
    in property <bool> single-line: true;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    callback key(KeyEvent) -> EventResult;
    forward-focus: input;
    // Height of the placeholder line in a multi-line field.
    property <length> line-height: Tokens.space-xl;
    height: Tokens.control-lg;
    border-radius: Tokens.radius-md;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    background: Tokens.bg-surface;
    border-width: input.has-focus ? Tokens.hairline : 0px;
    border-color: Tokens.focus-ring;
    Label {
        x: Tokens.space-md;
        width: parent.width - 2 * Tokens.space-md;
        height: root.single-line ? parent.height : root.line-height;
        y: root.single-line ? 0px : Tokens.space-sm;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: root.font-size;
        color: Tokens.text-tertiary;
        visible: root.text == "";
    }
    FocusScope {
        x: Tokens.space-md;
        width: parent.width - 2 * Tokens.space-md;
        key-pressed(e) => { return root.key(e); }
        input := TextInput {
            init => {
                if (root.auto-focus) {
                    self.focus();
                }
            }
            enabled: root.enabled;
            y: root.single-line ? 0px : Tokens.space-sm;
            width: parent.width;
            height: root.single-line ? root.height : root.height - 2 * Tokens.space-sm;
            vertical-alignment: root.single-line ? center : top;
            font-family: Tokens.font-family;
            font-size: root.font-size;
            color: Tokens.text-primary;
            selection-background-color: Tokens.accent;
            selection-foreground-color: Tokens.on-accent;
            single-line: root.single-line;
            wrap: root.single-line ? no-wrap : word-wrap;
            text <=> root.text;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    property <length> knob: 18px;
    property <length> inset: 3px;
    property <length> track-width: 40px;
    width: root.track-width;
    height: root.knob + 2 * root.inset;
    border-radius: Tokens.radius-full;
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    background: root.on ? Tokens.accent : (ta.has-hover ? Tokens.text-faint : Tokens.bg-track);
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    Rectangle {
        x: root.on ? parent.width - self.width - root.inset : root.inset;
        y: root.inset;
        width: root.knob;
        height: root.knob;
        border-radius: Tokens.radius-full;
        background: Tokens.text-bright;
        animate x { duration: Tokens.duration-fast; easing: Tokens.ease-in-out; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.on); }
    }
}
