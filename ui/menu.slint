// Context menu for tracks, albums, artists, playlists and episodes. src/menu.rs builds the items
// for what was clicked and runs the chosen action. Keyboard: Up/Down, Enter, Escape; Left goes
// back from a submenu.
import { Tokens } from "tokens.slint";
import { Label, Caption, ListRow, Card as Surface } from "base.slint";

export struct MenuItem {
    label: string,
    action: string,
    enabled: bool,
    // A line above this item.
    separator: bool,
    // Opens a submenu (shows a chevron).
    sub: bool,
}

export global Menu {
    in property <bool> open;
    in property <[MenuItem]> items;
    in property <string> title;
    // Click position in window coordinates; the overlay keeps the menu inside the window.
    in property <length> at-x;
    in property <length> at-y;
    in-out property <int> hot: -1;
    // A short confirmation after an action ("Link copied"); empty hides it.
    in property <string> toast;
    callback pick(string);
    callback close();
    callback back();
    // Requests from rows: (uri, context uri, index in context, queue uid, x, y).
    callback for-item(string, string, int, string, length, length);
}

export component MenuOverlay inherits Rectangle {
    property <length> item-h: 34px;
    property <length> menu-w: 248px;
    property <length> pad: Tokens.space-xs;
    property <length> title-h: Tokens.control-sm;
    // The menu keeps this distance from the window edge.
    property <length> margin: Tokens.space-sm;
    property <length> menu-h: Math.min(root.height - 2 * root.margin, (Menu.title != "" ? root.title-h : 0px) + Menu.items.length * root.item-h + 2 * root.pad + 2 * Tokens.hairline);
    // The toast floats above the bottom bar.
    property <length> toast-lift: 56px;

    if Menu.open : Rectangle {
        // Outside click closes.
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    Menu.close();
                }
            }
        }
        keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    Menu.close();
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    Menu.hot = Math.mod(Menu.hot + 1, Menu.items.length);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    Menu.hot = Menu.hot <= 0 ? Menu.items.length - 1 : Menu.hot - 1;
                    return accept;
                }
                if (event.text == Key.LeftArrow && Menu.title != "") {
                    Menu.back();
                    return accept;
                }
                if ((event.text == Key.Return || event.text == " " || event.text == Key.RightArrow) && Menu.hot >= 0 && Menu.items[Menu.hot].enabled) {
                    Menu.pick(Menu.items[Menu.hot].action);
                    return accept;
                }
                return accept;
            }
        }
        Surface {
            x: Math.max(root.margin, Math.min(Menu.at-x, root.width - root.menu-w - root.margin));
            y: Math.max(root.margin, Math.min(Menu.at-y, root.height - root.menu-h - root.margin));
            width: root.menu-w;
            height: root.menu-h;
            clip: true;
            // Swallow clicks on the menu itself.
            TouchArea { }
            VerticalLayout {
                padding: root.pad;
                spacing: 0;
                if Menu.title != "" : HorizontalLayout {
                    height: root.title-h;
                    padding-left: Tokens.space-sm;
                    Caption {
                        text: "‹  " + Menu.title;
                        font-weight: Tokens.weight-semibold;
                        color: back-ta.has-hover ? Tokens.text-secondary : Tokens.text-tertiary;
                        vertical-alignment: center;
                        animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                    }
                    back-ta := TouchArea { clicked => { Menu.back(); } }
                }
                Flickable {
                    content-height: Menu.items.length * root.item-h;
                    for it[i] in Menu.items : ListRow {
                        y: i * root.item-h;
                        height: root.item-h;
                        hovered: it.enabled && (Menu.hot == i || ta.has-hover);
                        pressed: it.enabled && ta.pressed;
                        if it.separator : Rectangle {
                            y: 0;
                            height: Tokens.hairline;
                            x: Tokens.space-sm;
                            width: parent.width - 2 * Tokens.space-sm;
                            background: Tokens.border;
                        }
                        Label {
                            x: Tokens.space-md;
                            width: parent.width - 2 * Tokens.space-md - (it.sub ? Tokens.space-lg : 0px);
                            height: parent.height;
                            vertical-alignment: center;
                            text: it.label;
                            color: it.enabled ? Tokens.text-primary : Tokens.text-tertiary;
                        }
                        if it.sub : Label {
                            x: parent.width - Tokens.space-xl;
                            height: parent.height;
                            vertical-alignment: center;
                            text: "›";
                            color: Tokens.text-secondary;
                        }
                        ta := TouchArea {
                            enabled: it.enabled;
                            moved => { Menu.hot = i; }
                            clicked => { Menu.pick(it.action); }
                        }
                    }
                }
            }
        }
    }

    if Menu.toast != "" : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - Tokens.bar-height - root.toast-lift;
        width: toast-text.preferred-width + 2 * Tokens.space-lg;
        height: Tokens.control-md;
        border-radius: Tokens.radius-full;
        background: Tokens.bg-inverse;
        toast-text := Label {
            x: Tokens.space-lg;
            height: parent.height;
            vertical-alignment: center;
            text: Menu.toast;
            color: Tokens.text-inverse;
            font-weight: Tokens.weight-medium;
        }
    }
}
