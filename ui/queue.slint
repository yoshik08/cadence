// Queue panel: Now Playing, Next Up (Play Next and queued items first, draggable; then the
// context), Recently played. src/queue.rs fills `Queue` from librespot's Connect queue.
import { Tokens } from "tokens.slint";
import { Cover } from "cover.slint";
import { ScrollView } from "std-widgets.slint";
import { Playback, Icons } from "now_playing.slint";
import { Label, Caption, ListRow, IconButton, SectionHeader } from "base.slint";
import { TrackRow, SongColumns } from "track_row.slint";
import { Browse } from "browse.slint";

export struct QueueRow {
    title: string,
    artist: string,
    duration: string,
    uri: string,
    uid: string,
    // In the user queue (draggable, removable) rather than the playing context.
    queued: bool,
    play-next: bool,
    unavailable: bool,
    explicit: bool,
    art: image,
    fresh: bool,
}

export global Queue {
    in property <[QueueRow]> next;
    in property <[QueueRow]> recent;
    in property <int> queued-count;
    in property <string> context-name;
    in property <string> summary;
    callback remove(string /* uid */);
    callback move-to(string /* uid */, int /* position in the user queue */);
    callback clear();
    // Skip forward to upcoming row n.
    callback play-row(int);
    // Right-click / menu key on a row: (uri, uid, x, y) in window coordinates.
    callback row-menu(string, string, length, length);
}

component Heading inherits Caption {
    property <length> heading-height: 28px;
    font-weight: Tokens.weight-semibold;
    color: Tokens.text-tertiary;
    height: root.heading-height;
    vertical-alignment: center;
}

// One queue row: the shared TrackRow (list variant) with the queue's drag handle in front of
// the cover and a remove button for queued items.
component Row inherits Rectangle {
    in property <QueueRow> item;
    in property <int> index;
    in property <bool> draggable;
    in property <length> row-h: Tokens.row-track;
    // Rows of the user queue; a drag is clamped to them.
    in property <int> drag-max;
    property <length> press-y;
    property <bool> dragging;
    property <length> offset;
    // Pointer travel before a press becomes a drag.
    property <length> drag-threshold: 6px;
    // Room for the drag handle before the cover.
    property <length> handle: Tokens.space-lg;
    height: root.row-h;
    z: root.dragging ? 10 : 0;

    row := TrackRow {
        y: root.offset;
        width: root.width;
        height: root.height;
        variant: "list";
        lead: root.handle;
        show-heart: false;
        show-more: !root.item.queued;
        removable: root.item.queued;
        lifted: root.dragging;
        item: {
            title: root.item.title,
            artist: root.item.play-next ? "Playing next · " + root.item.artist : root.item.artist,
            duration: root.item.duration,
            uri: root.item.uri,
            explicit: root.item.explicit,
            unavailable: root.item.unavailable,
            art: root.item.art,
            fresh: root.item.fresh,
        };
        double-clicked => {
            if (root.index >= 0) {
                Queue.play-row(root.index);
            } else {
                Browse.play(root.item.uri, 0);
            }
        }
        play-pause => {
            if (root.index >= 0) {
                Queue.play-row(root.index);
            } else {
                Browse.play(root.item.uri, 0);
            }
        }
        menu(x, y) => { Queue.row-menu(root.item.uri, root.item.uid, x, y); }
        more(x, y) => { Queue.row-menu(root.item.uri, root.item.uid, x, y); }
        remove => { Queue.remove(root.item.uid); }
        pointer(e, y) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.press-y = y;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.offset = 0px;
                Queue.move-to(root.item.uid, Math.clamp(root.index + Math.round((y - root.press-y) / root.row-h), 0, root.drag-max - 1));
            }
        }
        dragged(y, pressed) => {
            if (pressed && root.draggable) {
                if (abs(y - root.press-y) > root.drag-threshold) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.offset = y - root.press-y;
                }
            }
        }
    }
    if root.draggable : Path {
        x: SongColumns.inset + Tokens.space-2xs;
        y: root.offset + (root.height - self.height) / 2;
        width: Tokens.icon-xs;
        height: Tokens.icon-xs;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: Tokens.text-tertiary;
        stroke-width: Tokens.hairline;
        commands: "M2 3h8 M2 6h8 M2 9h8";
        opacity: row.hovered || root.dragging ? 1 : 0;
    }
}

export component QueuePanel inherits Rectangle {
    // Recently played rows are shown dimmed.
    property <float> recent-opacity: 0.7;
    property <length> clear-width: 64px;
    background: Tokens.bg-base;
    clip: true;
    Rectangle { x: 0; width: Tokens.hairline; background: Tokens.border; }

    VerticalLayout {
        padding: Tokens.space-lg;
        padding-top: Tokens.space-xl;
        spacing: Tokens.space-sm;
        HorizontalLayout {
            height: Tokens.control-sm;
            SectionHeader { title: "Queue"; inset: 0px; }
            if Queue.queued-count > 0 : Rectangle {
                width: root.clear-width;
                Caption {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    text: "Clear";
                    font-weight: Tokens.weight-medium;
                    color: clear-ta.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                }
                clear-ta := TouchArea { clicked => { Queue.clear(); } }
            }
            IconButton {
                size: Tokens.control-sm;
                icon-size: Tokens.icon-sm;
                icon: Icons.close;
                clicked => { Playback.toggle-queue(); }
            }
        }
        if Queue.summary != "" : Caption {
            text: Queue.summary;
            color: Tokens.text-tertiary;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0;
                padding-bottom: Tokens.space-xl;
                Heading { text: "Now playing"; }
                if Playback.title != "" : HorizontalLayout {
                    height: Tokens.row-lg;
                    spacing: Tokens.space-md;
                    padding-left: Tokens.space-xs;
                    Cover {
                        width: Tokens.art-thumb;
                        height: Tokens.art-thumb;
                        y: (parent.height - self.height) / 2;
                        source: Playback.bar-art;
                        fade: Playback.art-fresh;
                        radius: Tokens.radius-md;
                        backdrop: Tokens.bg-base;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Tokens.space-2xs;
                        Label { text: Playback.title; font-weight: Tokens.weight-semibold; color: Playback.accent; }
                        Caption { text: Playback.artist; }
                    }
                }
                if Playback.title == "" : Label { text: "Nothing playing"; color: Tokens.text-tertiary; height: Tokens.control-lg; }

                if Queue.queued-count > 0 : Heading { text: "Next in queue"; }
                for r[i] in Queue.next : VerticalLayout {
                    // The context heading goes above the first context row.
                    if i == Queue.queued-count : Heading {
                        text: Queue.context-name != "" ? "Next from: " + Queue.context-name : "Next up";
                        TouchArea { clicked => { Playback.open-context(); } }
                    }
                    Row {
                        item: r;
                        index: i;
                        draggable: r.queued;
                        drag-max: Queue.queued-count;
                    }
                }
                if Queue.next.length == 0 && Playback.title != "" : Label {
                    text: "Nothing up next.";
                    color: Tokens.text-tertiary;
                    height: Tokens.control-lg;
                }
                if Queue.recent.length > 0 : Heading { text: "Recently played"; }
                for r[i] in Queue.recent : Row {
                    item: r;
                    index: -1;
                    opacity: root.recent-opacity;
                }
            }
        }
    }
}
