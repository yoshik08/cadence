// Cadence browsing UI: sidebar, navigation and every browse page. Driven by `Browse`;
// src/browse.rs fills the models and answers the callbacks.
import { Tokens } from "tokens.slint";
import { ScrollView, ListView, Palette } from "std-widgets.slint";
import { Icons, Playback } from "now_playing.slint";
import { Menu } from "menu.slint";
import {
    Card, TrackRow, ShelfData, Label, Caption, Glyph, ListRow, Button, IconButton, SectionHeader,
    PageFade, ArtTile, CardView, Shelf, TrackItem, TableHeader, Chip, Field
} from "widgets.slint";

export { Card, TrackRow, ShelfData }

export struct SideItem {
    title: string,
    subtitle: string,
    uri: string,
    // "playlist" | "liked" | "folder" | "local" | "show" | "album" | "artist"
    kind: string,
    pinned: bool,
    depth: int,
    open: bool,
    art: image,
}

export struct StatRow {
    rank: int,
    title: string,
    subtitle: string,
    value: string,
    uri: string,
}

export global Browse {
    // Navigation. `page`: home | search | library | list | artist | stats | profile | settings.
    in-out property <string> page: "home";
    in property <bool> flip;
    in property <bool> loading;
    in property <string> error;
    in property <string> status;
    in property <string> current-uri;
    in property <color> accent: Tokens.accent;
    in property <bool> can-back;
    in property <bool> can-forward;
    // Page scroll, two-way bound to the page's list; Rust saves and restores it per history entry.
    in-out property <length> scroll-y;
    // Height of the page area, and a ping on every scroll: Rust uses both to load art for the
    // rows on screen first and the next screens ahead.
    in-out property <length> view-height;
    callback scrolled();
    in property <bool> compact;
    callback back();
    callback forward();
    callback open(string);
    callback go(string);
    callback play(string, int);
    callback play-all(string, bool);
    callback play-card(string);
    callback card-menu(string, length, length);

    // Home
    in property <string> greeting;
    in property <[ShelfData]> shelves;
    in property <bool> skeleton;
    in property <color> home-tint: Tokens.bg-base;
    in-out property <bool> home-editing;
    callback home-move(string, int);
    callback home-hide(string, bool);

    // Sidebar
    in property <[SideItem]> side-items;
    in-out property <string> side-filter;
    in property <bool> show-local;
    callback side-filter-edited(string);
    callback side-toggle(string);
    callback new-folder();
    callback create-playlist();

    // Search
    in-out property <string> query;
    in property <bool> has-top;
    in property <Card> top;
    in property <[TrackRow]> found-tracks;
    in property <[ShelfData]> found-shelves;
    in property <[string]> history;
    in property <string> search-note;
    in-out property <int> search-sel: -1;
    callback search(string);
    callback search-enter();
    callback history-pick(string);
    callback history-remove(string);
    callback history-clear();

    // Library
    in-out property <string> lib-tab: "playlist";
    in-out property <string> lib-sort: "recent";
    in-out property <string> lib-filter;
    in property <[Card]> lib-items;
    in property <string> lib-note;
    callback lib-changed();

    // List pages: playlist | album | liked | show | local | folder | showall | artist-liked
    in property <string> list-kind;
    in property <string> list-uri;
    in property <string> list-type;
    in property <string> list-title;
    in property <string> list-desc;
    in property <string> list-meta;
    in property <string> list-owner;
    in property <string> list-owner-uri;
    in property <string> list-note;
    in property <image> list-art;
    // The header art was downloaded just now (fades in); cached art appears at once.
    in property <bool> list-art-fresh;
    in property <bool> list-round;
    in property <bool> list-editable;
    in property <bool> list-saved;
    in property <bool> list-can-save;
    in property <bool> list-playable: true;
    in property <bool> list-more;
    in property <[TrackRow]> tracks;
    in property <[Card]> list-cards;
    in property <string> sort-key;
    in property <bool> sort-desc;
    callback sort-by(string);
    callback list-menu(length, length);
    callback toggle-save();
    callback track-heart(int);
    callback load-more();
    callback open-owner();
    // Find something for your playlist
    in property <[TrackRow]> find-tracks;
    in property <[Card]> find-cards;
    in property <string> find-note;
    in property <string> find-expanded;
    in-out property <bool> find-open;
    callback find(string);
    callback find-add(int);
    callback find-expand(string);

    // Artist
    in property <[TrackRow]> popular;
    in property <string> popular-title: "Popular";
    in property <string> popular-note;
    in property <[Card]> disc;
    in-out property <string> disc-filter: "all";
    in property <string> liked-note;
    in property <bool> following;
    callback set-disc-filter(string);
    callback toggle-follow();
    callback open-artist-liked();

    // Stats
    in-out property <string> stats-range: "4w";
    in property <string> stats-summary;
    in property <[StatRow]> stat-songs;
    in property <[StatRow]> stat-artists;
    in property <[StatRow]> stat-albums;
    callback stats-changed();
    callback stats-clear();

    // Profile (Cadence-local)
    in-out property <string> profile-name;
    in-out property <string> profile-bio;
    in property <image> profile-pic;
    callback profile-save();
    callback profile-pick();
}

// --------------------------------------------------------------------------------------------
// Sidebar

component NavItem inherits Rectangle {
    in property <SideItem> item;
    in property <string> icon;
    in property <bool> selected;
    in property <length> item-height: 40px;
    in property <bool> quiet;
    callback clicked();
    callback menu(length, length);
    // Children of a folder are indented one step; a folder's own icon makes room for its chevron.
    property <length> indent-step: 14px;
    property <length> indent: root.item.depth * root.indent-step + (root.item.kind == "folder" ? Tokens.space-xs : 0px);
    property <length> text-x: Tokens.space-md + Tokens.icon-md + Tokens.space-md + root.indent;
    height: root.item-height;
    ListRow {
        hovered: ta.has-hover;
        pressed: ta.pressed;
        selected: root.selected;
    }
    if root.item.kind == "folder" : Glyph {
        x: root.item.depth * root.indent-step;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-xs;
        commands: root.item.open ? Icons.chevron-down : Icons.forward;
        tint: Tokens.text-tertiary;
    }
    Glyph {
        x: Tokens.space-md + root.indent;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-md;
        commands: root.icon;
        solid: root.item.kind == "liked";
        tint: root.item.kind == "liked" ? Tokens.accent : (root.selected || ta.has-hover ? Tokens.text-primary : Tokens.text-secondary);
    }
    Label {
        x: root.text-x;
        y: (parent.height - self.height) / 2;
        width: parent.width - self.x - Tokens.space-md - (root.item.pinned ? Tokens.space-lg : 0px);
        text: root.item.title;
        font-weight: root.quiet ? Tokens.weight-regular : Tokens.weight-medium;
        color: root.selected || ta.has-hover ? Tokens.text-primary : Tokens.text-secondary;
        animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    }
    if root.item.pinned : Glyph {
        x: parent.width - self.width - Tokens.space-sm;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-xs;
        commands: Icons.pin;
        tint: Tokens.accent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    property <length> header-height: 40px;
    width: Tokens.sidebar-width;
    background: Tokens.bg-base;
    Rectangle { x: parent.width - Tokens.hairline; width: Tokens.hairline; background: Tokens.border; }
    VerticalLayout {
        padding: Tokens.space-md;
        padding-top: Tokens.space-lg;
        spacing: Tokens.space-xs;
        HorizontalLayout {
            height: root.header-height;
            padding-left: Tokens.space-xs;
            spacing: Tokens.space-xs;
            IconButton {
                y: (parent.height - self.height) / 2;
                round: true;
                size: Tokens.control-sm;
                icon: Icons.back;
                enabled: Browse.can-back;
                clicked => { Browse.back(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                round: true;
                size: Tokens.control-sm;
                icon: Icons.forward;
                enabled: Browse.can-forward;
                clicked => { Browse.forward(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                y: (parent.height - self.height) / 2;
                width: Tokens.icon-lg;
                height: Tokens.icon-lg;
                source: @image-url("../assets/icon-64.png");
                image-fit: contain;
                image-rendering: smooth;
            }
            Rectangle { width: Tokens.space-xs; }
            Label {
                horizontal-stretch: 0;
                text: "Cadence";
                font-size: Tokens.size-heading;
                font-weight: Tokens.weight-bold;
                letter-spacing: Tokens.tracking-heading;
                vertical-alignment: center;
            }
        }
        Rectangle { height: Tokens.space-xs; }
        NavItem { item: { title: "Home" }; icon: Icons.home; selected: Browse.page == "home"; clicked => { Browse.go("home"); } }
        NavItem { item: { title: "Search" }; icon: Icons.search; selected: Browse.page == "search"; clicked => { Browse.go("search"); } }
        NavItem { item: { title: "Your Library" }; icon: Icons.library; selected: Browse.page == "library"; clicked => { Browse.go("library"); } }
        HorizontalLayout {
            padding-top: Tokens.space-sm;
            spacing: Tokens.space-xs;
            Field {
                height: Tokens.control-sm;
                placeholder: "Filter";
                font-size: Tokens.size-caption;
                text <=> Browse.side-filter;
                edited(t) => { Browse.side-filter-edited(t); }
            }
            IconButton {
                round: true;
                size: Tokens.control-sm;
                icon: Icons.folder;
                clicked => { Browse.new-folder(); }
            }
            IconButton {
                round: true;
                size: Tokens.control-sm;
                icon: Icons.plus;
                clicked => { Browse.create-playlist(); }
            }
        }
        // Virtualized: only the visible playlists exist, however many there are.
        ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            for p in Browse.side-items : NavItem {
                item: p;
                item-height: Browse.compact ? Tokens.control-sm : Tokens.row-sm;
                quiet: true;
                icon: p.kind == "liked" ? Icons.heart : p.kind == "folder" ? Icons.folder : p.kind == "local" ? Icons.music : p.kind == "show" ? Icons.mic : Icons.playlist;
                selected: (Browse.page == "list" || Browse.page == "artist") && Browse.list-uri == p.uri;
                clicked => {
                    if (p.kind == "folder") {
                        Browse.side-toggle(p.uri);
                    } else {
                        Browse.open(p.uri);
                    }
                }
                menu(x, y) => { Browse.card-menu(p.uri, x, y); }
            }
        }
        HorizontalLayout {
            height: Tokens.control-md;
            spacing: Tokens.space-xs;
            alignment: start;
            IconButton { round: true; icon: Icons.chart; clicked => { Browse.go("stats"); } }
            IconButton { round: true; icon: Icons.user; clicked => { Browse.go("profile"); } }
            IconButton { round: true; icon: Icons.gear; clicked => { Browse.go("settings"); } }
        }
    }
}

// --------------------------------------------------------------------------------------------
// Pages

export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> status;
    padding-top: Tokens.space-xl;
    padding-left: Tokens.page-margin;
    padding-right: Tokens.page-margin;
    padding-bottom: Tokens.space-lg;
    spacing: Tokens.space-xs;
    vertical-stretch: 0;
    Label {
        text: root.title;
        font-size: Tokens.size-title;
        font-weight: Tokens.weight-bold;
        letter-spacing: Tokens.tracking-title;
    }
    if root.status != "" : Label { text: root.status; color: Tokens.text-secondary; }
}

// A hand-placed grid of cards: column count from the width, one cell per card.
global CardGrid {
    out property <length> cell-width: Tokens.art-card + Tokens.space-lg;
    out property <length> cell-height: 220px;
    public pure function cols(width: length) -> int {
        return Math.max(1, Math.floor((width - 2 * Tokens.page-margin + Tokens.space-lg) / self.cell-width));
    }
}

component ShelfBlock inherits VerticalLayout {
    in property <ShelfData> data;
    in property <int> index;
    in property <length> art-size: Tokens.art-card;
    in property <bool> skeleton;
    spacing: Tokens.space-md;
    padding-bottom: Tokens.space-xl;
    HorizontalLayout {
        padding-right: Tokens.page-margin;
        SectionHeader {
            title: root.data.title;
            action: root.data.more != "" ? "Show all" : "";
            action-clicked => { Browse.open(root.data.more); }
        }
        if Browse.home-editing : HorizontalLayout {
            spacing: Tokens.space-xs;
            Button { size: Tokens.control-sm; text: "↑"; clicked => { Browse.home-move(root.data.key, -1); } }
            Button { size: Tokens.control-sm; text: "↓"; clicked => { Browse.home-move(root.data.key, 1); } }
            Button { size: Tokens.control-sm; text: "Hide"; clicked => { Browse.home-hide(root.data.key, true); } }
        }
    }
    if root.data.note != "" : HorizontalLayout {
        padding-left: Tokens.page-margin;
        Caption { text: root.data.note; wrap: word-wrap; }
    }
    if root.data.cards.length > 0 || root.skeleton : Shelf {
        model: root.data.cards;
        art-size: root.art-size;
        skeleton: root.skeleton;
        picked(uri) => { Browse.open(uri); }
        play(uri) => { Browse.play-card(uri); }
        menu(uri, x, y) => { Browse.card-menu(uri, x, y); }
    }
}

component HomePage inherits PageFade {
    // The art-tinted wash behind the top of the page.
    property <length> tint-height: 320px;
    property <float> tint-alpha: 0.35;
    // Recently played uses smaller cards than the other shelves.
    property <length> recent-art: 140px;
    Rectangle {
        height: root.tint-height;
        y: 0;
        background: @linear-gradient(180deg, Browse.home-tint.with-alpha(root.tint-alpha) 0%, Tokens.bg-base 100%);
        animate background { duration: Tokens.duration-slow; easing: Tokens.ease-out; }
    }
    ScrollView {
        content-y <=> Browse.scroll-y;
        VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                padding-right: Tokens.page-margin;
                PageTitle { title: Browse.greeting; status: Browse.status; }
                Button {
                    y: Tokens.space-xl;
                    size: Tokens.control-md;
                    text: Browse.home-editing ? "Done" : "Customize";
                    active: Browse.home-editing;
                    clicked => { Browse.home-editing = !Browse.home-editing; }
                }
            }
            for sh[i] in Browse.shelves : ShelfBlock {
                data: sh;
                index: i;
                art-size: sh.key == "recent" ? root.recent-art : Tokens.art-card;
                skeleton: Browse.skeleton;
                visible: !sh.hidden;
                height: sh.hidden ? 0px : self.preferred-height;
            }
            if Browse.home-editing : VerticalLayout {
                padding: Tokens.page-margin;
                spacing: Tokens.space-sm;
                Caption { text: "Hidden sections"; }
                for sh in Browse.shelves : HorizontalLayout {
                    visible: sh.hidden;
                    height: sh.hidden ? Tokens.row-sm : 0px;
                    spacing: Tokens.space-md;
                    Label { text: sh.title; vertical-alignment: center; }
                    Button { size: Tokens.control-sm; text: "Show"; clicked => { Browse.home-hide(sh.key, false); } }
                }
            }
        }
    }
}

// The "Top result" tile on the search page.
component TopResult inherits Rectangle {
    property <length> tile-height: 220px;
    property <length> art: 96px;
    property <length> play: 48px;
    property <bool> hot: ta.has-hover || play-ta.has-hover;
    height: root.tile-height;
    border-radius: Tokens.radius-lg;
    background: ta.pressed ? Tokens.bg-surface : root.hot ? Tokens.bg-elevated : Tokens.bg-surface;
    animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
    ArtTile {
        x: Tokens.space-xl;
        y: Tokens.space-xl;
        width: root.art;
        height: root.art;
        radius: Browse.top.round ? root.art / 2 : Tokens.radius-md;
        backdrop: root.hot ? Tokens.bg-elevated : Tokens.bg-surface;
        source: Browse.top.art;
        fade: Browse.top.fresh;
    }
    Label {
        x: Tokens.space-xl;
        y: Tokens.space-xl + root.art + Tokens.space-lg;
        width: parent.width - 2 * Tokens.space-xl;
        text: Browse.top.title;
        font-size: Tokens.size-title;
        font-weight: Tokens.weight-bold;
        letter-spacing: Tokens.tracking-title;
    }
    Caption {
        x: Tokens.space-xl;
        y: parent.height - Tokens.space-xl - self.height;
        width: parent.width - 2 * Tokens.space-xl - root.play - Tokens.space-md;
        text: Browse.top.subtitle;
    }
    ta := TouchArea { clicked => { Browse.open(Browse.top.uri); } }
    Rectangle {
        x: parent.width - self.width - Tokens.space-lg;
        y: parent.height - self.height - Tokens.space-lg;
        width: root.play;
        height: root.play;
        border-radius: Tokens.radius-full;
        background: Tokens.accent;
        opacity: root.hot ? 1 : 0;
        animate opacity { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
        Glyph {
            x: (parent.width - self.width) / 2 + Tokens.hairline;
            y: (parent.height - self.height) / 2;
            size: Tokens.icon-lg;
            solid: true;
            tint: Tokens.on-accent;
            commands: Icons.play;
        }
        play-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Browse.play-card(Browse.top.uri); } }
    }
}

component SearchPage inherits PageFade {
    property <string> line: Browse.status != "" ? Browse.status : Browse.search-note;
    property <length> field-height: Tokens.row-md;
    property <length> top-width: Tokens.panel-width;
    // Results dim while a newer search is on its way.
    property <float> loading-opacity: 0.6;
    VerticalLayout {
        spacing: 0;
        PageTitle { title: "Search"; }
        HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-right: Tokens.page-margin;
            Field {
                height: root.field-height;
                font-size: Tokens.size-heading;
                placeholder: "What do you want to play? (or paste a Spotify link)";
                auto-focus: true;
                text <=> Browse.query;
                edited(t) => { Browse.search-sel = -1; Browse.search(t); }
                accepted => { Browse.search-enter(); }
                key(e) => {
                    if (e.text == Key.DownArrow) {
                        Browse.search-sel = Math.min(Browse.search-sel + 1, Browse.found-tracks.length - 1);
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        Browse.search-sel = Math.max(Browse.search-sel - 1, -1);
                        return accept;
                    }
                    if (e.text == Key.Escape && Browse.query != "") {
                        Browse.query = "";
                        Browse.search("");
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Rectangle { height: Tokens.space-lg; vertical-stretch: 0; }
        ScrollView {
            vertical-stretch: 1;
            content-y <=> Browse.scroll-y;
            VerticalLayout {
                spacing: Tokens.space-xl;
                padding-bottom: Tokens.page-margin;
                opacity: Browse.loading ? root.loading-opacity : 1;
                animate opacity { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                if root.line != "" : HorizontalLayout {
                    padding-left: Tokens.page-margin;
                    Label { text: root.line; color: Tokens.text-secondary; }
                }
                // History when the field is empty.
                if Browse.query == "" && Browse.history.length > 0 : VerticalLayout {
                    spacing: Tokens.space-sm;
                    HorizontalLayout {
                        padding-right: Tokens.page-margin;
                        SectionHeader { title: "Recent searches"; }
                        Button { size: Tokens.control-sm; text: "Clear"; clicked => { Browse.history-clear(); } }
                    }
                    for h in Browse.history : Rectangle {
                        height: Tokens.control-lg;
                        ListRow {
                            x: Tokens.space-xl;
                            width: parent.width - 2 * Tokens.space-xl;
                            hovered: hta.has-hover;
                            pressed: hta.pressed;
                        }
                        Glyph { x: Tokens.page-margin; y: (parent.height - self.height) / 2; commands: Icons.search; }
                        Label { x: Tokens.page-margin + Tokens.icon-md + Tokens.space-md; height: parent.height; vertical-alignment: center; text: h; }
                        hta := TouchArea { clicked => { Browse.history-pick(h); } }
                        IconButton {
                            x: parent.width - Tokens.page-margin - self.width;
                            y: (parent.height - self.height) / 2;
                            round: true;
                            size: Tokens.control-sm;
                            icon-size: Tokens.icon-sm;
                            icon: Icons.close;
                            clicked => { Browse.history-remove(h); }
                        }
                    }
                }
                if Browse.has-top || Browse.found-tracks.length > 0 : HorizontalLayout {
                    padding-left: Tokens.page-margin;
                    padding-right: Tokens.page-margin;
                    spacing: Tokens.space-xl;
                    if Browse.has-top : VerticalLayout {
                        width: root.top-width;
                        spacing: Tokens.space-md;
                        SectionHeader { title: "Top result"; inset: 0px; }
                        TopResult { }
                    }
                    if Browse.found-tracks.length > 0 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Tokens.space-md;
                        SectionHeader {
                            title: "Songs";
                            inset: 0px;
                            action: "Show all";
                            action-clicked => { Browse.open("showall:track:" + Browse.query); }
                        }
                        for t[i] in Browse.found-tracks : TrackItem {
                            item: t;
                            number: 0;
                            show-album: false;
                            show-heart: false;
                            selected: Browse.search-sel == i;
                            playing: t.uri == Browse.current-uri;
                            clicked => { Browse.search-sel = i; }
                            double-clicked => { Browse.play(t.uri, 0); }
                            menu(x, y) => { Menu.for-item(t.uri, "", -1, "", x, y); }
                        }
                    }
                }
                for sh in Browse.found-shelves : VerticalLayout {
                    spacing: Tokens.space-md;
                    SectionHeader {
                        title: sh.title;
                        action: sh.more != "" ? "Show all" : "";
                        action-clicked => { Browse.open(sh.more); }
                    }
                    Shelf {
                        model: sh.cards;
                        picked(uri) => { Browse.open(uri); }
                        play(uri) => { Browse.play-card(uri); }
                        menu(uri, x, y) => { Browse.card-menu(uri, x, y); }
                    }
                }
            }
        }
    }
}

component LibRow inherits Rectangle {
    in property <Card> card;
    callback clicked();
    // Compact layout: shorter rows with smaller art.
    property <length> compact-height: 48px;
    property <length> compact-art: Tokens.control-md;
    property <length> art: Browse.compact ? root.compact-art : Tokens.art-thumb;
    property <length> art-x: Tokens.space-xl + Tokens.space-sm;
    // Room on the right for the pin.
    property <length> trailing: 60px;
    // The art's corners are painted in the colour behind them, which follows the row state.
    property <color> behind: ta.pressed ? Tokens.text-primary.mix(Tokens.bg-base, 0.12) : (ta.has-hover ? Tokens.text-primary.mix(Tokens.bg-base, 0.06) : Tokens.bg-base);
    height: Browse.compact ? root.compact-height : Tokens.row-lg;
    ListRow {
        x: Tokens.space-xl;
        width: parent.width - 2 * Tokens.space-xl;
        hovered: ta.has-hover;
        pressed: ta.pressed;
    }
    ArtTile {
        x: root.art-x;
        y: (parent.height - self.height) / 2;
        width: root.art;
        height: root.art;
        radius: root.card.round ? root.art / 2 : Tokens.radius-md;
        backdrop: root.behind;
        source: root.card.art;
        fade: root.card.fresh;
        liked: root.card.liked;
        local: root.card.local;
    }
    VerticalLayout {
        x: root.art-x + root.art + Tokens.space-lg;
        width: parent.width - self.x - Tokens.space-xl - Tokens.space-lg - root.trailing;
        alignment: center;
        spacing: Tokens.space-2xs;
        Label { text: root.card.title; font-weight: Tokens.weight-medium; }
        Caption { text: (root.card.local ? "Local folder · " : "") + root.card.subtitle; }
    }
    if root.card.pinned : Glyph {
        x: parent.width - Tokens.space-xl - Tokens.space-lg - self.width;
        y: (parent.height - self.height) / 2;
        size: Tokens.icon-sm;
        commands: Icons.pin;
        tint: Tokens.accent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                Browse.card-menu(root.card.uri, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component LibraryPage inherits PageFade {
    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            padding-right: Tokens.page-margin;
            PageTitle { title: "Your Library"; status: Browse.status; }
            Button { y: Tokens.space-xl; kind: "primary"; text: "Create playlist"; clicked => { Browse.create-playlist(); } }
        }
        HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-right: Tokens.page-margin;
            spacing: Tokens.space-sm;
            height: Tokens.control-sm;
            Chip { text: "Playlists"; selected: Browse.lib-tab == "playlist"; clicked => { Browse.lib-tab = "playlist"; Browse.lib-changed(); } }
            Chip { text: "Albums"; selected: Browse.lib-tab == "album"; clicked => { Browse.lib-tab = "album"; Browse.lib-changed(); } }
            Chip { text: "Artists"; selected: Browse.lib-tab == "artist"; clicked => { Browse.lib-tab = "artist"; Browse.lib-changed(); } }
            Chip { text: "Podcasts"; selected: Browse.lib-tab == "show"; clicked => { Browse.lib-tab = "show"; Browse.lib-changed(); } }
            Chip { text: "Liked Songs"; selected: Browse.lib-tab == "track"; clicked => { Browse.lib-tab = "track"; Browse.lib-changed(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            padding: Tokens.page-margin;
            padding-top: Tokens.space-lg;
            padding-bottom: Tokens.space-md;
            spacing: Tokens.space-sm;
            Field {
                placeholder: "Search in Your Library";
                text <=> Browse.lib-filter;
                edited => { Browse.lib-changed(); }
            }
            Chip { y: (parent.height - self.height) / 2; text: "Recents"; selected: Browse.lib-sort == "recent"; clicked => { Browse.lib-sort = "recent"; Browse.lib-changed(); } }
            Chip { y: (parent.height - self.height) / 2; text: "Alphabetical"; selected: Browse.lib-sort == "alpha"; clicked => { Browse.lib-sort = "alpha"; Browse.lib-changed(); } }
            Chip { y: (parent.height - self.height) / 2; text: "Creator"; selected: Browse.lib-sort == "creator"; clicked => { Browse.lib-sort = "creator"; Browse.lib-changed(); } }
        }
        if Browse.lib-note != "" : HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-bottom: Tokens.space-md;
            Caption { text: Browse.lib-note; wrap: word-wrap; }
        }
        // Virtualized: only the visible rows exist; art is requested as rows appear.
        ListView {
            vertical-stretch: 1;
            content-y <=> Browse.scroll-y;
            for c in Browse.lib-items : LibRow {
                card: c;
                clicked => { Browse.open(c.uri); }
            }
        }
    }
}

component ListHeader inherits HorizontalLayout {
    property <length> art-size: Tokens.art-header;
    // The description shows at most two lines.
    property <length> desc-max: 44px;
    padding: Tokens.page-margin;
    padding-bottom: Tokens.space-lg;
    spacing: Tokens.space-xl;
    if Browse.list-kind != "showall" : ArtTile {
        width: root.art-size;
        height: root.art-size;
        radius: Browse.list-round ? root.art-size / 2 : Tokens.radius-lg;
        source: Browse.list-art;
        fade: Browse.list-art-fresh;
        liked: Browse.list-kind == "liked";
        local: Browse.list-kind == "local" || Browse.list-kind == "folder";
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: end;
        spacing: Tokens.space-sm;
        Label { text: Browse.list-type; color: Tokens.text-secondary; font-weight: Tokens.weight-medium; }
        Label {
            text: Browse.list-title;
            font-size: Tokens.size-title;
            font-weight: Tokens.weight-bold;
            letter-spacing: Tokens.tracking-title;
        }
        if Browse.list-desc != "" : Label {
            text: Browse.list-desc;
            color: Tokens.text-secondary;
            wrap: word-wrap;
            max-height: root.desc-max;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: Tokens.space-xs;
            if Browse.list-owner != "" : Rectangle {
                width: own.preferred-width;
                own := Label { height: parent.height; text: Browse.list-owner; font-weight: Tokens.weight-semibold; color: oa.has-hover ? Tokens.text-bright : Tokens.text-primary; }
                oa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Browse.open-owner(); } }
            }
            if Browse.list-owner != "" && Browse.list-meta != "" : Label { text: "·"; color: Tokens.text-secondary; }
            Label { text: Browse.list-meta; color: Tokens.text-secondary; horizontal-stretch: 1; }
        }
        Rectangle { height: Tokens.space-sm; }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-sm;
            if Browse.list-playable : Button { kind: "primary"; text: "Play"; clicked => { Browse.play-all(Browse.list-uri, false); } }
            if Browse.list-playable : Button { text: "Shuffle"; clicked => { Browse.play-all(Browse.list-uri, true); } }
            if Browse.list-can-save : IconButton {
                round: true;
                size: Tokens.control-lg;
                icon-size: Tokens.icon-lg;
                icon: Icons.heart;
                solid: Browse.list-saved;
                tint: Browse.list-saved ? Tokens.accent : Tokens.text-secondary;
                clicked => { Browse.toggle-save(); }
            }
            if Browse.list-kind != "showall" && Browse.list-kind != "artist-liked" : IconButton {
                round: true;
                size: Tokens.control-lg;
                icon-size: Tokens.icon-lg;
                icon: Icons.more;
                clicked-at(x, y) => { Browse.list-menu(x, y); }
            }
            if Browse.list-editable && Browse.list-kind == "playlist" : Button {
                text: Browse.find-open ? "Back to songs" : "Add songs";
                active: Browse.find-open;
                clicked => { Browse.find-open = !Browse.find-open; }
            }
        }
    }
}

component FindSection inherits VerticalLayout {
    spacing: Tokens.space-md;
    padding-top: Tokens.space-md;
    padding-bottom: Tokens.page-margin;
    SectionHeader { title: "Let's find something for your playlist"; }
    HorizontalLayout {
        padding-left: Tokens.page-margin;
        padding-right: Tokens.page-margin;
        Field {
            auto-focus: true;
            placeholder: "Search for songs, artists or albums";
            edited(t) => { Browse.find(t); }
            accepted(t) => { Browse.find(t); }
        }
    }
    if Browse.find-note != "" : HorizontalLayout {
        padding-left: Tokens.page-margin;
        Caption { text: Browse.find-note; }
    }
    if Browse.find-cards.length > 0 : HorizontalLayout {
        padding-left: Tokens.page-margin;
        spacing: Tokens.space-sm;
        alignment: start;
        for c in Browse.find-cards : Chip {
            text: (c.round ? "Artist: " : "Album: ") + c.title;
            selected: Browse.find-expanded == c.uri;
            clicked => { Browse.find-expand(c.uri); }
        }
    }
    for t[i] in Browse.find-tracks : TrackItem {
        item: t;
        number: 0;
        show-heart: false;
        action-label: "Add";
        double-clicked => { Browse.play(t.uri, 0); }
        action => { Browse.find-add(i); }
        menu(x, y) => { Menu.for-item(t.uri, "", -1, "", x, y); }
    }
}

component ListPage inherits PageFade {
    property <bool> episodes: Browse.list-kind == "show";
    property <bool> with-added: Browse.list-kind == "playlist" || Browse.list-kind == "liked";
    property <bool> with-album: Browse.list-kind != "album" && !root.episodes;
    property <string> line: Browse.status != "" ? Browse.status : Browse.list-note;
    property <bool> card-page: Browse.list-cards.length > 0;
    property <bool> finding: Browse.find-open && Browse.list-editable && Browse.list-kind == "playlist";
    property <int> cols: CardGrid.cols(root.width);
    VerticalLayout {
        ListHeader { vertical-stretch: 0; }
        if root.line != "" : HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-right: Tokens.page-margin;
            padding-bottom: Tokens.space-md;
            Label { text: root.line; color: Tokens.text-secondary; wrap: word-wrap; }
        }
        if !root.finding && Browse.tracks.length > 0 : TableHeader {
            show-album: root.with-album;
            show-added: root.with-added;
            show-heart: !root.episodes && Browse.list-kind != "local";
            sort-key: Browse.sort-key;
            sort-desc: Browse.sort-desc;
            sortable: Browse.list-kind == "playlist" || Browse.list-kind == "liked" || Browse.list-kind == "local";
            sort(k) => { Browse.sort-by(k); }
        }
        // Virtualized: only the visible rows exist, for any list length.
        if !root.finding && !root.card-page : ListView {
            vertical-stretch: 1;
            content-y <=> Browse.scroll-y;
            for t[i] in Browse.tracks : TrackItem {
                item: t;
                number: i + 1;
                show-album: root.with-album;
                show-added: root.with-added;
                show-heart: !root.episodes && Browse.list-kind != "local";
                playing: t.uri != "" && t.uri == Browse.current-uri;
                double-clicked => { Browse.play(Browse.list-uri, i); }
                heart => { Browse.track-heart(i); }
                menu(x, y) => { Menu.for-item(t.uri, Browse.list-uri, i, "", x, y); }
            }
        }
        // Card results ("Show all"), virtualized by grid row.
        if !root.finding && root.card-page : ListView {
            vertical-stretch: 1;
            content-y <=> Browse.scroll-y;
            for r in Math.ceil(Browse.list-cards.length / root.cols) : Rectangle {
                height: CardGrid.cell-height;
                for k in root.cols : Rectangle {
                    x: Tokens.page-margin + k * CardGrid.cell-width;
                    width: CardGrid.cell-width;
                    if r * root.cols + k < Browse.list-cards.length : CardView {
                        x: 0;
                        y: 0;
                        card: Browse.list-cards[r * root.cols + k];
                        clicked => { Browse.open(self.card.uri); }
                        play => { Browse.play-card(self.card.uri); }
                        menu(x, y) => { Browse.card-menu(self.card.uri, x, y); }
                    }
                }
            }
        }
        if root.finding : ScrollView {
            vertical-stretch: 1;
            FindSection { }
        }
        if Browse.list-more && !root.finding : HorizontalLayout {
            padding: Tokens.space-md;
            alignment: center;
            vertical-stretch: 0;
            Button { size: Tokens.control-md; text: "Load more"; clicked => { Browse.load-more(); } }
        }
    }
}

component ArtistPage inherits PageFade {
    property <length> photo: 216px;
    property <length> liked-width: 320px;
    property <int> cols: CardGrid.cols(root.width);
    ScrollView {
      content-y <=> Browse.scroll-y;
      VerticalLayout {
        HorizontalLayout {
            padding: Tokens.page-margin;
            padding-bottom: Tokens.space-lg;
            spacing: Tokens.space-xl;
            ArtTile { width: root.photo; height: root.photo; radius: root.photo / 2; source: Browse.list-art; fade: Browse.list-art-fresh; }
            VerticalLayout {
                alignment: end;
                spacing: Tokens.space-sm;
                horizontal-stretch: 1;
                Label { text: "Artist"; color: Tokens.text-secondary; font-weight: Tokens.weight-medium; }
                Label { text: Browse.list-title; font-size: Tokens.size-display; font-weight: Tokens.weight-bold; letter-spacing: Tokens.tracking-display; }
                Rectangle { height: Tokens.space-sm; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-sm;
                    Button { kind: "primary"; text: "Play"; clicked => { Browse.play-all(Browse.list-uri, false); } }
                    Button { text: "Shuffle"; clicked => { Browse.play-all(Browse.list-uri, true); } }
                    Button { text: Browse.following ? "Following" : "Follow"; active: Browse.following; clicked => { Browse.toggle-follow(); } }
                    IconButton { round: true; size: Tokens.control-lg; icon-size: Tokens.icon-lg; icon: Icons.more; clicked-at(x, y) => { Browse.list-menu(x, y); } }
                }
            }
        }
        if Browse.status != "" : HorizontalLayout {
            padding-left: Tokens.page-margin;
            Label { text: Browse.status; color: Tokens.text-secondary; }
        }
        if Browse.liked-note != "" : HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-bottom: Tokens.space-lg;
            Rectangle {
                width: root.liked-width;
                height: Tokens.row-lg;
                border-radius: Tokens.radius-lg;
                background: lta.pressed ? Tokens.bg-surface : lta.has-hover ? Tokens.bg-elevated : Tokens.bg-surface;
                animate background { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                Glyph { x: Tokens.space-lg; y: (parent.height - self.height) / 2; size: Tokens.icon-lg; solid: true; tint: Tokens.accent; commands: Icons.heart; }
                VerticalLayout {
                    x: Tokens.space-lg + Tokens.icon-lg + Tokens.space-lg;
                    alignment: center;
                    Label { text: "Liked songs"; font-weight: Tokens.weight-semibold; }
                    Caption { text: Browse.liked-note; }
                }
                lta := TouchArea { clicked => { Browse.open-artist-liked(); } }
            }
        }
        SectionHeader { title: Browse.popular-title; }
        if Browse.popular-note != "" : HorizontalLayout {
            padding-left: Tokens.page-margin;
            Caption { text: Browse.popular-note; wrap: word-wrap; }
        }
        for t[i] in Browse.popular : TrackItem {
            item: t;
            number: i + 1;
            show-album: true;
            playing: t.uri == Browse.current-uri;
            double-clicked => { Browse.play("popular", i); }
            heart => { Browse.track-heart(-1 - i); }
            menu(x, y) => { Menu.for-item(t.uri, "", -1, "", x, y); }
        }
        Rectangle { height: Tokens.space-xl; }
        SectionHeader { title: "Discography"; }
        HorizontalLayout {
            padding-left: Tokens.page-margin;
            padding-top: Tokens.space-sm;
            padding-bottom: Tokens.space-md;
            spacing: Tokens.space-sm;
            alignment: start;
            Chip { text: "All"; selected: Browse.disc-filter == "all"; clicked => { Browse.set-disc-filter("all"); } }
            Chip { text: "Albums"; selected: Browse.disc-filter == "album"; clicked => { Browse.set-disc-filter("album"); } }
            Chip { text: "Singles and EPs"; selected: Browse.disc-filter == "single"; clicked => { Browse.set-disc-filter("single"); } }
            Chip { text: "Compilations"; selected: Browse.disc-filter == "compilation"; clicked => { Browse.set-disc-filter("compilation"); } }
        }
        // The discography loads a few dozen cards at a time (Load more), so it stays a plain grid.
        Rectangle {
            height: Math.ceil(Browse.disc.length / root.cols) * CardGrid.cell-height;
            for c[i] in Browse.disc : CardView {
                x: Tokens.page-margin + Math.mod(i, root.cols) * CardGrid.cell-width;
                y: Math.floor(i / root.cols) * CardGrid.cell-height;
                card: c;
                clicked => { Browse.open(c.uri); }
                play => { Browse.play-card(c.uri); }
                menu(x, y) => { Browse.card-menu(c.uri, x, y); }
            }
        }
        if Browse.list-more : HorizontalLayout {
            padding: Tokens.space-xl;
            alignment: center;
            Button { text: "Load more"; clicked => { Browse.load-more(); } }
        }
        Rectangle { height: Tokens.page-margin; }
      }
    }
}

component StatList inherits VerticalLayout {
    in property <string> title;
    in property <[StatRow]> rows;
    property <length> rank-width: 28px;
    property <length> value-width: 76px;
    spacing: 0;
    horizontal-stretch: 1;
    SectionHeader { title: root.title; inset: 0px; }
    if root.rows.length == 0 : Caption { text: "Nothing yet."; height: Tokens.control-sm; }
    for r in root.rows : Rectangle {
        height: Tokens.control-lg;
        ListRow {
            hovered: ta.has-hover && r.uri != "";
            pressed: ta.pressed && r.uri != "";
        }
        Label { x: Tokens.space-xs; width: root.rank-width; height: parent.height; vertical-alignment: center; text: "\{r.rank}"; color: Tokens.text-tertiary; }
        VerticalLayout {
            x: Tokens.space-xs + root.rank-width + Tokens.space-xs;
            width: parent.width - self.x - root.value-width - Tokens.space-xs;
            alignment: center;
            Label { text: r.title; font-weight: Tokens.weight-medium; }
            if r.subtitle != "" : Caption { text: r.subtitle; }
        }
        Caption { x: parent.width - root.value-width - Tokens.space-xs; width: root.value-width; height: parent.height; vertical-alignment: center; horizontal-alignment: right; text: r.value; }
        ta := TouchArea { clicked => { if (r.uri != "") { Browse.open(r.uri); } } }
    }
}

component StatsPage inherits PageFade {
    ScrollView {
        content-y <=> Browse.scroll-y;
        VerticalLayout {
            alignment: start;
            PageTitle { title: "Listening stats"; status: "Counts only what Cadence played on this PC. Private session pauses recording."; }
            HorizontalLayout {
                padding-left: Tokens.page-margin;
                padding-right: Tokens.page-margin;
                spacing: Tokens.space-sm;
                height: Tokens.control-sm;
                Chip { text: "4 weeks"; selected: Browse.stats-range == "4w"; clicked => { Browse.stats-range = "4w"; Browse.stats-changed(); } }
                Chip { text: "6 months"; selected: Browse.stats-range == "6m"; clicked => { Browse.stats-range = "6m"; Browse.stats-changed(); } }
                Chip { text: "All time"; selected: Browse.stats-range == "all"; clicked => { Browse.stats-range = "all"; Browse.stats-changed(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { size: Tokens.control-sm; text: "Clear listening history"; clicked => { Browse.stats-clear(); } }
            }
            HorizontalLayout {
                padding: Tokens.page-margin;
                padding-bottom: Tokens.space-md;
                Label { text: Browse.stats-summary; font-size: Tokens.size-heading; }
            }
            HorizontalLayout {
                padding-left: Tokens.page-margin;
                padding-right: Tokens.page-margin;
                padding-bottom: Tokens.page-margin;
                spacing: Tokens.space-2xl;
                alignment: stretch;
                StatList { title: "Top songs"; rows: Browse.stat-songs; }
                StatList { title: "Top artists"; rows: Browse.stat-artists; }
                StatList { title: "Top albums"; rows: Browse.stat-albums; }
            }
        }
    }
}

component ProfilePage inherits PageFade {
    property <length> form-width: 420px;
    property <length> bio-height: 120px;
    VerticalLayout {
        PageTitle { title: "Cadence profile"; status: "Stored only on this PC. Spotify doesn't let apps edit your Spotify profile."; }
        HorizontalLayout {
            padding: Tokens.page-margin;
            spacing: Tokens.space-2xl;
            alignment: start;
            VerticalLayout {
                spacing: Tokens.space-md;
                ArtTile { width: Tokens.art-card; height: Tokens.art-card; radius: Tokens.art-card / 2; source: Browse.profile-pic; fade: false; }
                Button { size: Tokens.control-md; text: "Choose picture…"; clicked => { Browse.profile-pick(); } }
            }
            VerticalLayout {
                width: root.form-width;
                spacing: Tokens.space-sm;
                Caption { text: "Display name"; }
                Field { text <=> Browse.profile-name; placeholder: "Your name"; }
                Rectangle { height: Tokens.space-sm; }
                Caption { text: "Bio"; }
                Field { height: root.bio-height; single-line: false; text <=> Browse.profile-bio; placeholder: "A few words"; }
                Rectangle { height: Tokens.space-md; }
                HorizontalLayout { alignment: start; Button { kind: "primary"; text: "Save"; clicked => { Browse.profile-save(); } } }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// Fills its parent; the bottom belongs to the now-playing bar.
export component BrowseArea inherits Rectangle {
    background: Tokens.bg-base;
    clip: true;
    init => {
        Palette.color-scheme = ColorScheme.dark;
        Browse.view-height = self.height;
    }
    changed height => { Browse.view-height = self.height; }
    property <length> scroll-y: Browse.scroll-y;
    changed scroll-y => { Browse.scrolled(); }
    property <length> error-h: Browse.error != "" ? Tokens.control-md : 0px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - root.error-h;
        if Browse.page == "home" : HomePage { }
        if Browse.page == "search" : SearchPage { }
        if Browse.page == "library" : LibraryPage { }
        if Browse.page == "list" && !Browse.flip : ListPage { }
        if Browse.page == "list" && Browse.flip : ListPage { }
        if Browse.page == "artist" && !Browse.flip : ArtistPage { }
        if Browse.page == "artist" && Browse.flip : ArtistPage { }
        if Browse.page == "stats" : StatsPage { }
        if Browse.page == "profile" : ProfilePage { }
        @children
    }
    if Browse.error != "" : Label {
        x: Tokens.page-margin;
        y: parent.height - root.error-h;
        width: parent.width - 2 * Tokens.page-margin;
        height: root.error-h;
        text: Browse.error;
        color: Tokens.text-secondary;
        vertical-alignment: center;
    }
}
