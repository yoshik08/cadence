// Mini player (always on top, remembers its position) and the media-key overlay. Separate
// windows have their own globals, so everything here is plain properties set by src/mini.rs.
import { Tokens } from "tokens.slint";
import { Cover } from "cover.slint";
import { Icons, Scrubber } from "now_playing.slint";
import { Label, Caption, Glyph, IconButton, Card as Surface } from "base.slint";

export component MiniWindow inherits Window {
    title: "Cadence mini player";
    icon: @image-url("../assets/icon-256.png");
    no-frame: true;
    always-on-top: true;
    property <length> window-width: 380px;
    // The cover, in logical px. Rust asks for art at this size times the scale factor.
    out property <length> cover-size: 72px;
    property <length> seek-height: Tokens.icon-md;
    property <length> volume-width: 84px;
    property <length> text-x: Tokens.space-md + root.cover-size + Tokens.space-md;
    // Close and expand buttons, top right.
    property <length> corner-buttons: 2 * Tokens.control-sm;
    width: root.window-width;
    height: Tokens.space-md + root.cover-size + Tokens.space-sm + root.seek-height + Tokens.space-md;
    background: Tokens.bg-base;
    default-font-family: Tokens.font-family;

    in property <string> track-title;
    in property <string> artist;
    in property <image> art;
    in property <bool> art-fresh;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in-out property <float> volume;
    in property <color> accent: Tokens.accent;
    callback play-pause();
    callback next();
    callback prev();
    callback seek(int);
    callback set-volume(float);
    callback close-mini();
    callback expand();
    callback drag();

    Rectangle {
        border-radius: Tokens.radius-lg;
        border-width: Tokens.hairline;
        border-color: Tokens.border-strong;
    }
    // Drag anywhere that isn't a control.
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag();
            }
        }
    }
    Cover {
        x: Tokens.space-md;
        y: Tokens.space-md;
        width: root.cover-size;
        height: root.cover-size;
        source: root.art;
        fade: root.art-fresh;
        radius: Tokens.radius-md;
        backdrop: Tokens.bg-base;
        placeholder: root.track-title == "" ? Tokens.bg-surface : Tokens.art-placeholder;
    }
    VerticalLayout {
        x: root.text-x;
        y: Tokens.space-md;
        width: root.width - root.text-x - root.corner-buttons - Tokens.space-xl - Tokens.space-sm;
        spacing: Tokens.space-2xs;
        Label { text: root.track-title == "" ? "Nothing playing" : root.track-title; font-weight: Tokens.weight-semibold; }
        Caption { text: root.artist; }
    }
    Image {
        x: root.width - root.corner-buttons - Tokens.space-sm - Tokens.space-xl;
        y: Tokens.space-sm + (Tokens.control-sm - self.height) / 2;
        width: Tokens.icon-sm;
        height: Tokens.icon-sm;
        source: @image-url("../assets/icon-64.png");
        image-fit: contain;
        image-rendering: smooth;
    }
    IconButton { x: root.width - root.corner-buttons - Tokens.space-sm; y: Tokens.space-sm; round: true; size: Tokens.control-sm; icon-size: Tokens.icon-sm; icon: Icons.mini; clicked => { root.expand(); } }
    IconButton { x: root.width - Tokens.control-sm - Tokens.space-sm; y: Tokens.space-sm; round: true; size: Tokens.control-sm; icon-size: Tokens.icon-sm; icon: Icons.close; clicked => { root.close-mini(); } }
    HorizontalLayout {
        x: root.text-x - Tokens.space-xs;
        y: Tokens.space-md + root.cover-size - Tokens.control-md;
        height: Tokens.control-md;
        spacing: Tokens.space-2xs;
        alignment: start;
        IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-sm; icon: Icons.prev; solid: true; tint: Tokens.text-primary; clicked => { root.prev(); } }
        IconButton { y: (parent.height - self.height) / 2; round: true; icon-size: Tokens.icon-lg; icon: root.playing ? Icons.pause : Icons.play; solid: true; tint: Tokens.text-primary; clicked => { root.play-pause(); } }
        IconButton { y: (parent.height - self.height) / 2; round: true; size: Tokens.control-sm; icon: Icons.next; solid: true; tint: Tokens.text-primary; clicked => { root.next(); } }
        Rectangle { width: Tokens.space-md; }
        Glyph {
            y: (parent.height - self.height) / 2;
            size: Tokens.icon-md;
            commands: Icons.volume-low;
        }
        Scrubber {
            y: (parent.height - self.height) / 2;
            width: root.volume-width;
            value: root.volume;
            fill-color: root.accent;
            live(v) => {
                root.volume = v;
                root.set-volume(v);
            }
            released(v) => {
                root.volume = v;
                root.set-volume(v);
            }
        }
    }
    // Seek bar along the bottom.
    Scrubber {
        x: Tokens.space-md;
        y: root.height - Tokens.space-sm - self.height;
        width: root.width - 2 * Tokens.space-md;
        height: root.seek-height;
        value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
        fill-color: root.accent;
        enabled: root.duration-ms > 0;
        released(v) => { root.seek(Math.round(v * root.duration-ms)); }
    }
}

export component OsdWindow inherits Window {
    title: "Cadence";
    no-frame: true;
    always-on-top: true;
    property <length> window-width: 360px;
    out property <length> cover-size: 60px;
    width: root.window-width;
    height: root.cover-size + 2 * Tokens.space-md;
    background: transparent;
    default-font-family: Tokens.font-family;
    in property <string> line1;
    in property <string> line2;
    in property <string> line3;
    in property <image> art;
    Surface {
        raised: false;
        background: Tokens.bg-overlay;
        border-color: Tokens.border-strong;
    }
    Cover {
        x: Tokens.space-md;
        y: Tokens.space-md;
        width: root.cover-size;
        height: root.cover-size;
        source: root.art;
        fade: false;
        radius: Tokens.radius-md;
        backdrop: Tokens.bg-surface;
    }
    VerticalLayout {
        x: Tokens.space-md + root.cover-size + Tokens.space-md;
        width: root.width - self.x - Tokens.space-md;
        alignment: center;
        spacing: Tokens.space-2xs;
        Caption { text: root.line1; font-weight: Tokens.weight-semibold; color: Tokens.text-tertiary; }
        Label { text: root.line2; font-weight: Tokens.weight-semibold; }
        Caption { text: root.line3; }
    }
}
