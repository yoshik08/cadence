// Right-side Now Playing panel: art, track, synced lyrics and the per-song timing offset.
// Shown on artist and album pages by default and whenever the user opens it.
import { Tokens } from "tokens.slint";
import { Cover } from "cover.slint";
import { Playback, Icons } from "now_playing.slint";
import { Label, Caption, Button, IconButton, SectionHeader } from "base.slint";

export component NowPlayingPanel inherits Rectangle {
    background: Tokens.bg-base;
    clip: true;
    Rectangle { x: 0; width: Tokens.hairline; background: Tokens.border; }
    property <length> line-h: 34px;
    property <length> offset-label: 56px;
    VerticalLayout {
        padding: Tokens.space-lg;
        spacing: Tokens.space-md;
        HorizontalLayout {
            height: Tokens.control-sm;
            SectionHeader { title: "Now playing"; inset: 0px; }
            IconButton { size: Tokens.control-sm; icon-size: Tokens.icon-sm; icon: Icons.close; clicked => { Playback.side-open = false; } }
        }
        if Playback.title == "" : Caption { text: "Nothing playing."; }
        if Playback.title != "" : Cover {
            height: self.width;
            source: Playback.side-art;
            fade: Playback.art-fresh;
            radius: Tokens.radius-lg;
            backdrop: Tokens.bg-base;
        }
        if Playback.title != "" : VerticalLayout {
            spacing: Tokens.space-2xs;
            Label { text: Playback.title; font-size: Tokens.size-heading; font-weight: Tokens.weight-semibold; }
            Rectangle {
                height: artist-t.preferred-height;
                artist-t := Caption {
                    text: Playback.artist;
                    font-size: Tokens.size-body;
                    color: aa.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                    animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                }
                aa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Playback.open-artist(); } }
            }
        }
        if Playback.title != "" : HorizontalLayout {
            spacing: Tokens.space-xs;
            Label { text: "Lyrics"; font-weight: Tokens.weight-semibold; vertical-alignment: center; horizontal-stretch: 1; }
            if Playback.lyr-plain.length > 0 && Playback.lyr-synced : HorizontalLayout {
                spacing: Tokens.space-2xs;
                Button { size: Tokens.control-sm; text: "−0.1s"; clicked => { Playback.lyrics-offset(-100); } }
                Caption { width: root.offset-label; text: Playback.lyr-offset == 0 ? "in sync" : (Playback.lyr-offset > 0 ? "+" : "") + Playback.lyr-offset / 1000 + "s"; horizontal-alignment: center; vertical-alignment: center; }
                Button { size: Tokens.control-sm; text: "+0.1s"; clicked => { Playback.lyrics-offset(100); } }
            }
        }
        if Playback.title != "" && Playback.lyr-plain.length == 0 : Caption { text: Playback.lyr-hint != "" ? Playback.lyr-hint : "No lyrics for this track."; wrap: word-wrap; }
        if Playback.lyr-plain.length > 0 : flick := Flickable {
            vertical-stretch: 1;
            content-height: Playback.lyr-plain.length * root.line-h + self.height;
            // Keep the active line about a third of the way down.
            content-y: Playback.lyr-synced && Playback.lyr-active >= 0 ? Math.min(0px, -(Playback.lyr-active * root.line-h) + self.height / 3) : 0px;
            animate content-y { duration: Tokens.duration-slow; easing: Tokens.ease-in-out; }
            for l[i] in Playback.lyr-plain : Rectangle {
                y: i * root.line-h;
                height: root.line-h;
                Label {
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    text: l;
                    font-weight: Tokens.weight-semibold;
                    color: !Playback.lyr-synced ? Tokens.text-primary : (i == Playback.lyr-active ? Tokens.text-primary : (i < Playback.lyr-active ? Tokens.text-tertiary : Tokens.text-secondary));
                    animate color { duration: Tokens.duration-fast; easing: Tokens.ease-out; }
                }
                TouchArea { clicked => { Playback.seek-line(i); } }
            }
        }
    }
}
