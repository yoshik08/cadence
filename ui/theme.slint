// Cadence design tokens. One family (Geist, bundled subset), near-black base, one accent.
import "../assets/fonts/Geist-400-700.ttf";

export global Theme {
    // Colour. The accent below is only the default; now-playing overrides it per album.
    out property <color> bg: #0a0a0b;
    out property <color> surface: #131315;
    out property <color> surface-raised: #1c1c1f;
    out property <color> text: #ffffffeb;
    out property <color> text-secondary: #ffffffa6;
    out property <color> text-tertiary: #ffffff7a;
    out property <color> divider: #ffffff14;
    out property <color> hover: #ffffff0f;
    out property <color> pressed: #ffffff1f;
    out property <color> track: #ffffff29;
    out property <color> accent: #7f9bff;
    out property <color> on-accent: #0a0a0b;

    // Type. Scale 12 / 15 / 20 / 30 / 48 (roughly x1.25, x1.33, x1.5, x1.6): tighter steps for
    // UI text, wider ones for titles. Tracking tightens as size grows.
    out property <string> font-family: "Geist";
    out property <length> size-caption: 12px;
    out property <length> size-body: 15px;
    out property <length> size-heading: 20px;
    out property <length> size-title: 30px;
    out property <length> size-display: 48px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
    out property <length> tracking-caption: 0.2px;
    out property <length> tracking-body: 0px;
    out property <length> tracking-heading: -0.2px;
    out property <length> tracking-title: -0.6px;
    out property <length> tracking-display: -1.4px;

    // Spacing, 4px base.
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-2xl: 32px;
    out property <length> space-3xl: 48px;

    // Radii: art and cards larger than controls.
    out property <length> radius-art: 16px;
    out property <length> radius-thumb: 10px;
    out property <length> radius-card: 12px;
    out property <length> radius-control: 8px;
    out property <length> radius-small: 6px;
    out property <length> radius-pill: 999px;

    // Motion, only on user action.
    out property <duration> duration-fast: 120ms;
    out property <duration> duration-normal: 220ms;
    out property <easing> ease: cubic-bezier(0.22, 1, 0.36, 1);
}
