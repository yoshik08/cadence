// Album art with rounded corners. Slint's software renderer ignores both Image border-radius and
// the radius of a clipping Rectangle, so the corners are cut by painting four small shapes in the
// colour behind the art. `backdrop` is that colour (`backdrop-bottom` too, if it is a vertical
// gradient behind the art). Without an image it shows a plain rounded surface.
import { Theme } from "theme.slint";

component Corner inherits Path {
    in property <length> r;
    width: r;
    height: r;
    viewbox-width: 1;
    viewbox-height: 1;
}

export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.radius-thumb;
    in property <color> backdrop: Theme.bg;
    in property <color> backdrop-bottom: backdrop;
    property <bool> has-art: root.source.width > 0;

    background: Theme.surface;
    border-radius: root.radius;

    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
        visible: root.has-art;
    }

    Corner { x: 0; y: 0; r: root.radius; visible: root.has-art; fill: root.backdrop; commands: "M0 0 L1 0 A1 1 0 0 0 0 1 Z"; }
    Corner { x: root.width - self.width; y: 0; r: root.radius; visible: root.has-art; fill: root.backdrop; commands: "M1 0 L0 0 A1 1 0 0 1 1 1 Z"; }
    Corner { x: root.width - self.width; y: root.height - self.height; r: root.radius; visible: root.has-art; fill: root.backdrop-bottom; commands: "M1 1 L1 0 A1 1 0 0 1 0 1 Z"; }
    Corner { x: 0; y: root.height - self.height; r: root.radius; visible: root.has-art; fill: root.backdrop-bottom; commands: "M0 1 L0 0 A1 1 0 0 0 1 1 Z"; }
}
