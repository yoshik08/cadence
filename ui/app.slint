import { Tokens } from "tokens.slint";
import { Browse, Sidebar, BrowseArea, Card, TrackRow, ShelfData, SideItem, StatRow } from "browse.slint";
import { Playback, NowPlayingBar, LyrLine, LyrRow, LyrWord, LyrLetter, KWord, KMotion } from "now_playing.slint";
import { LyricsOverlay } from "lyrics.slint";
import { Queue, QueueRow, QueuePanel } from "queue.slint";
import { Menu, MenuItem, MenuOverlay } from "menu.slint";
import { Dialog, DialogOverlay } from "dialog.slint";
import { Settings, SettingsPage, DeviceRow } from "settings.slint";
import { NowPlayingPanel } from "side.slint";
import { MiniWindow, OsdWindow } from "mini.slint";
// The lyrics page type (yoshik.xyz uses Bricolage Grotesque; these are static instances of it).
import "../assets/fonts/Bricolage-500.ttf";
import "../assets/fonts/Bricolage-600.ttf";
import "../assets/fonts/Bricolage-SemiCondensed-700.ttf";
import "../assets/fonts/Bricolage-SemiCondensed-800.ttf";
import "../assets/fonts/JetBrainsMono-500.ttf";

export {
    Menu, MenuItem, Queue, QueueRow, Browse, Card, TrackRow, ShelfData, SideItem, StatRow, Playback,
    LyrLine, LyrRow, LyrWord, LyrLetter, KWord, KMotion, Dialog, Settings, DeviceRow, MiniWindow, OsdWindow
}

export component MainWindow inherits Window {
    title: "Cadence";
    icon: @image-url("../assets/icon-256.png");
    property <length> start-width: 1200px;
    property <length> start-height: 780px;
    property <length> smallest-width: 960px;
    property <length> smallest-height: 640px;
    preferred-width: root.start-width;
    preferred-height: root.start-height;
    min-width: root.smallest-width;
    min-height: root.smallest-height;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.size-body;
    background: Tokens.bg-base;

    callback play-pause-key();
    callback lyrics-key(string);
    // Ctrl / Alt shortcuts handled in Rust: zoom-in, zoom-out, zoom-reset, back, forward, paste,
    // copy-now-playing.
    callback shortcut(string);
    // Window resize / fullscreen toggle: Rust re-wraps the lyric lines for the new size.
    callback relayout-lyrics();
    changed width => { root.relayout-lyrics(); }
    changed height => { root.relayout-lyrics(); }

    property <string> page: Browse.page;
    property <bool> expanded: Playback.expanded;
    property <bool> menu-open: Menu.open;
    property <bool> dialog-open: Dialog.open;
    changed menu-open => {
        if (!root.menu-open) {
            keys.focus();
        }
    }
    changed dialog-open => {
        if (!root.dialog-open) {
            keys.focus();
        }
    }
    changed page => {
        if (root.page != "search") {
            keys.focus();
        }
    }
    changed expanded => {
        keys.focus();
        root.relayout-lyrics();
    }

    property <length> side-w: Tokens.sidebar-width;
    property <length> right-w: Playback.queue-open || Playback.side-open ? Tokens.panel-width : 0px;

    // Outermost container so keys typed into text fields bubble up to it.
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                root.shortcut("zoom-in");
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.shortcut("zoom-out");
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.shortcut("zoom-reset");
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.shortcut("back");
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.RightArrow) {
                root.shortcut("forward");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                root.shortcut("copy-now-playing");
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                root.shortcut("paste");
                return accept;
            }
            if (event.modifiers.control && (event.text == "l" || event.text == "L" || event.text == "k" || event.text == "K")) {
                Browse.go("search");
                return accept;
            }
            if (event.text == " " && !event.repeat) {
                root.play-pause-key();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (Playback.expanded) {
                    Playback.expanded = false;
                } else {
                    keys.focus();
                }
                return accept;
            }
            // Lyrics page: K toggles karaoke (karaoke builds).
            if (Playback.expanded && !event.repeat && event.text == "k") {
                root.lyrics-key(event.text);
                return accept;
            }
            return reject;
        }

        Sidebar {
            x: 0px;
            y: 0px;
            width: root.side-w;
            height: root.height - Tokens.bar-height;
        }

        BrowseArea {
            x: root.side-w;
            y: 0px;
            width: root.width - root.side-w - root.right-w;
            height: root.height - Tokens.bar-height;
            if Browse.page == "settings" : SettingsPage { }
        }

        if Playback.queue-open : QueuePanel {
            x: root.width - Tokens.panel-width;
            y: 0px;
            width: Tokens.panel-width;
            height: root.height - Tokens.bar-height;
        }

        if Playback.side-open && !Playback.queue-open : NowPlayingPanel {
            x: root.width - Tokens.panel-width;
            y: 0px;
            width: Tokens.panel-width;
            height: root.height - Tokens.bar-height;
        }

        NowPlayingBar {
            x: 0px;
            y: root.height - Tokens.bar-height;
            width: root.width;
        }

        LyricsOverlay {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
        }

        DialogOverlay {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
        }

        MenuOverlay {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
        }
    }

    init => { keys.focus(); }
}
