import { Theme } from "theme.slint";
import { Browse, Sidebar, BrowseArea } from "browse.slint";
import { Playback, NowPlayingBar, NowPlayingView, LyricLine } from "now_playing.slint";

export { Browse, Playback, LyricLine }

export component MainWindow inherits Window {
    title: "Cadence";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 640px;
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-body;
    background: Theme.bg;

    callback play-pause-key();
    // Window resize / fullscreen toggle: the lyrics word-rows are split for the real
    // window width, so Rust re-splits them whenever the width changes.
    callback relayout-lyrics();
    changed width => { root.relayout-lyrics(); }

    // Space and Escape are handled here, so this FocusScope must hold the focus whenever the search
    // field is not in use. A click anywhere else already gives it back; the search field is
    // destroyed when the page changes and is hidden behind the full player, so reclaim it then.
    property <string> page: Browse.page;
    property <bool> expanded: Playback.expanded;
    changed page => {
        if (root.page != "search") {
            keys.focus();
        }
    }
    changed expanded => { keys.focus(); }

    // Outermost container so keys typed into the search field bubble up to it (Space is typed, not handled).
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == " " && !event.repeat) {
                root.play-pause-key();
                return accept;
            }
            if (event.text == Key.Escape) {
                // Collapse the full player; otherwise leave the search field.
                if (Playback.expanded) {
                    Playback.expanded = false;
                } else {
                    keys.focus();
                }
                return accept;
            }
            return reject;
        }

        Sidebar {
            x: 0px;
            y: 0px;
            width: 216px;
            height: root.height - 88px;
        }

        BrowseArea {
            x: 216px;
            y: 0px;
            width: root.width - 216px;
            height: root.height - 88px;
        }

        NowPlayingView {
            x: 0px;
            y: Playback.expanded ? 0px : 24px;
            width: root.width;
            height: root.height - 88px;
            opacity: Playback.expanded ? 1 : 0;
            animate opacity, y { duration: Theme.duration-normal; easing: Theme.ease; }
        }

        NowPlayingBar {
            x: 0px;
            y: root.height - 88px;
            width: root.width;
        }
    }

    init => { keys.focus(); }
}
