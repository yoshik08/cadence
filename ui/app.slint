import { Theme } from "theme.slint";
import { Browse, Sidebar, BrowseArea } from "browse.slint";
import { Playback, NowPlayingBar, LyrLine, LyrRow, LyrWord, LyrLetter, KWord, KMotion } from "now_playing.slint";
import { LyricsOverlay } from "lyrics.slint";
// The lyrics page type (yoshik.xyz uses Bricolage Grotesque; these are static instances of it).
import "../assets/fonts/Bricolage-500.ttf";
import "../assets/fonts/Bricolage-600.ttf";
import "../assets/fonts/Bricolage-SemiCondensed-700.ttf";
import "../assets/fonts/Bricolage-SemiCondensed-800.ttf";
import "../assets/fonts/JetBrainsMono-500.ttf";

export { Browse, Playback, LyrLine, LyrRow, LyrWord, LyrLetter, KWord, KMotion }

export component MainWindow inherits Window {
    title: "Cadence";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 640px;
    default-font-family: Theme.font-family;
    default-font-size: Theme.size-body;
    background: Theme.bg;

    callback play-pause-key();
    callback lyrics-key(string);
    // Window resize / fullscreen toggle: Rust re-wraps the lyric lines for the new size.
    callback relayout-lyrics();
    changed width => { root.relayout-lyrics(); }
    changed height => { root.relayout-lyrics(); }

    // Space and Escape are handled here, so this FocusScope must hold the focus whenever the search
    // field is not in use. A click anywhere else already gives it back; the search field is
    // destroyed when the page changes and is hidden behind the lyrics page, so reclaim it then.
    property <string> page: Browse.page;
    property <bool> expanded: Playback.expanded;
    changed page => {
        if (root.page != "search") {
            keys.focus();
        }
    }
    changed expanded => {
        keys.focus();
        root.relayout-lyrics();
    }

    // Outermost container so keys typed into the search field bubble up to it (Space is typed, not handled).
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        key-pressed(event) => {
            if (event.text == " " && !event.repeat) {
                root.play-pause-key();
                return accept;
            }
            if (event.text == Key.Escape) {
                // Close the lyrics page; otherwise leave the search field.
                if (Playback.expanded) {
                    Playback.expanded = false;
                } else {
                    keys.focus();
                }
                return accept;
            }
            // Lyrics page: K toggles karaoke (karaoke builds).
            if (Playback.expanded && !event.repeat && event.text == "k") {
                root.lyrics-key(event.text);
                return accept;
            }
            return reject;
        }

        Sidebar {
            x: 0px;
            y: 0px;
            width: 216px;
            height: root.height - 88px;
        }

        BrowseArea {
            x: 216px;
            y: 0px;
            width: root.width - 216px;
            height: root.height - 88px;
        }

        NowPlayingBar {
            x: 0px;
            y: root.height - 88px;
            width: root.width;
        }

        LyricsOverlay {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
        }
    }

    init => { keys.focus(); }
}
