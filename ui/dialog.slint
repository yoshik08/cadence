// One modal dialog at a time: confirmations, text input (create / rename / edit details) and
// the playlist cover picker. src/dialogs.rs opens it and handles the result.
import { Tokens } from "tokens.slint";
import { Label, Caption, Button, Card as Surface } from "base.slint";
import { Field, ArtTile } from "widgets.slint";

export global Dialog {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    in property <string> field1-label;
    in-out property <string> field1;
    in property <string> field2-label;
    in-out property <string> field2;
    in property <string> ok-label: "OK";
    in property <string> cancel-label: "Cancel";
    in property <bool> danger;
    // Optional third button (e.g. "Choose image…") and a line about its result.
    in property <string> extra-label;
    in property <string> extra-note;
    in property <image> extra-image;
    in property <bool> busy;
    callback ok();
    callback cancel();
    callback extra();
}

export component DialogOverlay inherits Rectangle {
    property <length> dialog-width: 460px;
    // The description field shows about four lines.
    property <length> notes-height: 88px;
    if Dialog.open : Rectangle {
        background: Tokens.scrim;
        TouchArea { }
        FocusScope {
            init => {
                if (Dialog.field1-label == "") {
                    self.focus();
                }
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    Dialog.cancel();
                    return accept;
                }
                if (e.text == Key.Return && !Dialog.busy) {
                    Dialog.ok();
                    return accept;
                }
                return reject;
            }
            Surface {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: root.dialog-width;
                height: box.preferred-height;
                outlined: false;
                box := VerticalLayout {
                    padding: Tokens.space-xl;
                    spacing: Tokens.space-md;
                    Label {
                        text: Dialog.title;
                        font-size: Tokens.size-heading;
                        font-weight: Tokens.weight-semibold;
                        wrap: word-wrap;
                    }
                    if Dialog.message != "" : Label {
                        text: Dialog.message;
                        color: Tokens.text-secondary;
                        wrap: word-wrap;
                    }
                    if Dialog.field1-label != "" : VerticalLayout {
                        spacing: Tokens.space-xs;
                        Caption { text: Dialog.field1-label; }
                        Field {
                            auto-focus: true;
                            text <=> Dialog.field1;
                            accepted => { Dialog.ok(); }
                        }
                    }
                    if Dialog.field2-label != "" : VerticalLayout {
                        spacing: Tokens.space-xs;
                        Caption { text: Dialog.field2-label; }
                        Field { height: root.notes-height; single-line: false; text <=> Dialog.field2; }
                    }
                    if Dialog.extra-label != "" : HorizontalLayout {
                        spacing: Tokens.space-md;
                        alignment: start;
                        if Dialog.extra-image.width > 0 : ArtTile {
                            width: Tokens.art-thumb;
                            height: Tokens.art-thumb;
                            radius: Tokens.radius-md;
                            backdrop: Tokens.bg-elevated;
                            source: Dialog.extra-image;
                        }
                        Button { size: Tokens.control-md; text: Dialog.extra-label; clicked => { Dialog.extra(); } }
                        Caption { text: Dialog.extra-note; vertical-alignment: center; wrap: word-wrap; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Tokens.space-sm;
                        padding-top: Tokens.space-sm;
                        if Dialog.cancel-label != "" : Button { text: Dialog.cancel-label; clicked => { Dialog.cancel(); } }
                        Button {
                            kind: Dialog.danger ? "danger" : "primary";
                            text: Dialog.busy ? "Working…" : Dialog.ok-label;
                            enabled: !Dialog.busy;
                            clicked => { Dialog.ok(); }
                        }
                    }
                }
            }
        }
    }
}
